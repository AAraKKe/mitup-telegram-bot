{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "rm -rf .claude/agents_running && mkdir -p .claude/agents_running"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p .claude/agents_running && echo 1 >> .claude/agents_running/in"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p .claude/agents_running && echo 1 >> .claude/agents_running/out"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bin/claude_stop_hook.sh dev:test-hook"
          },
          {
            "type": "command",
            "command": "bin/claude_stop_hook.sh dev:type-check"
          },
          {
            "type": "command",
            "command": "output=$(hatch run dev:fix 2>&1); code=$?; [ $code -eq 0 ] || { echo \"$output\" >&2; exit 2; }"
          }
        ]
      }
    ]
  }
}
