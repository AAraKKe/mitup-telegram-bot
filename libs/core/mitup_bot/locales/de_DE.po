msgstr "Limits und Host-Vorteile"

msgid "CommonMessages.OLD_VERSION_MESSAGE"
msgstr "Diese Nachricht stammt aus einer älteren Version von Mitup, deshalb funktionieren ihre Buttons nicht mehr. Dein Konto und deine Treffen sind sicher. Öffne das Hauptmenü, um weiterzumachen."

msgid "CommonMessages.STALE_BUTTONS_NOTICE"
msgstr "Diese Buttons gehören zu einer alten Nachricht und ich weiß nicht mehr, was wir dort gemacht haben. Diese Nachricht ist jetzt das Hauptmenü, von hier aus kannst du weitermachen."

msgid "AdminMessages.BUTTON_SUPPORTER_GRANTS"
msgstr "🎁 Host-Zuweisungen"

msgid "GrantOperatorMessages.TARGET_PROMPT"
msgstr "<b>Host-Zuweisungen</b>\n\nSende die Telegram-ID oder den @Benutzernamen der Person, die du verwalten möchtest. Nur registrierte Mitglieder können eine Host-Stufe erhalten."

msgid "GrantOperatorMessages.TARGET_NOT_FOUND"
msgstr "🚫 Kein Mitglied passt zu <code>${identifier}</code>. Prüfe die ID oder den Benutzernamen und sende sie erneut."

msgid "GrantOperatorMessages.TARGET_SUMMARY"
msgstr "<b>${name}</b>\nTelegram-ID: <code>${tg_user_id}</code>\nAktuelle Stufe: ${current_level}\nZugewiesene Stufe: ${granted_level}\nPatreon verknüpft: ${patreon_linked}\n\nWähle die Host-Stufe, die zugewiesen werden soll. Die zugewiesene Stufe ist eine Untergrenze: Patreon-Änderungen setzen die Person nie darunter."

msgid "GrantOperatorMessages.CONFIRM_PROMPT"
msgstr "Die zugewiesene Host-Stufe für <b>${name}</b> auf ${level} setzen?"

msgid "GrantOperatorMessages.APPLIED_CONFIRMATION"
msgstr "Die zugewiesene Host-Stufe für <b>${name}</b> ist jetzt ${level}."

msgid "GrantOperatorMessages.CANCELLED_CONFIRMATION"
