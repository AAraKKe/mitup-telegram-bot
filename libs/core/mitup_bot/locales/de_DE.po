msgid "MeetingEditLocationMessages.DESCRIPTION"
msgstr "Einem Treffen kann eine GPS-Position hinzugefügt werden. Du kannst dem Ort bloß einen Namen geben, oder zusätzlich eine GPS-Position hinzufügen. Wähle eine der beiden Möglichkeiten."

msgid "MeetingEditLocationMessages.NAME_PROMPT"
msgstr "Sende mir den Namen des Ortes."

msgid "MeetingEditLocationMessages.COORDINATES_PROMPT"
msgstr "<i>Nur vom Telefon 📱</i>\n\n"
"Sende den Ort des Treffens. Tippe auf das 📎 Symbol und wähle dann Ort. Du kannst jeden beliebigen Ort senden, nicht nur deinen aktuellen Ort."

msgid "MeetingEditLocationMessages.NAME_SUCCESS"
msgstr "Der Name des Ortes wurde auf <b>${name}</b> gesetzt"

msgid "MeetingEditLocationMessages.COORDINATES_SUCCESS"
