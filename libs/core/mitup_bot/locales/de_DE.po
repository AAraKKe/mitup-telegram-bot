msgid "MeetingEditParticipantsMessages.MAX_INVALID"
msgstr "Die maximale Anzahl der Teilnehmer muss eine Zahl größer als 0 sein. Bitte versuche es erneut"

msgid "MeetingEditParticipantsMessages.KICK_OUT_DESCRIPTION"
