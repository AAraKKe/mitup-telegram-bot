msgid "HelpMessages.INTRO"
msgstr "Wo du Hilfe zu Mitup bekommst:"

msgid "HelpMessages.USER_GUIDE"
msgstr "Das ${button_guide} führt dich Seite für Seite durch jeden Bildschirm. Der beste Einstieg."

msgid "HelpMessages.COMMUNITY_GROUP"
msgstr "Die ${button_group} steht allen offen, die Mitup nutzen. Komm rein und frag, was du willst."

msgid "HelpMessages.NEWS_CHANNEL"
msgstr "Der ${button_channel} meldet jede neue Version und was sich geändert hat. Folge ihm, um es zuerst zu erfahren."

msgid "HelpMessages.EMAIL"
msgstr "✉️ Für alles Persönliche schreib an support@mitup.social. Eine Person liest deine Nachricht."

msgid "MeetingListMessages.ACTIVE_EMPTY_ALERT"
msgstr "Du hast keine aktiven Treffen. Tippe auf Neues Treffen, um eins zu erstellen."

msgid "MeetingListMessages.JOINED_EMPTY_ALERT"
msgstr "Du bist noch keinem Treffen beigetreten."

msgid "MeetingListMessages.PAST_EMPTY_ALERT"
msgstr "Du hast noch keine vergangenen Treffen."

msgid "CommonMessages.STALE_CANCEL_ALERT"
msgstr "Du hast diese Frage bereits beantwortet"

msgid "CommonMessages.EDITING_REVAMP_BANNER"
msgstr "✨ Das Bearbeiten wurde überarbeitet! Alles passiert jetzt direkt auf der Seite des Treffens."

msgid "CommonMessages.POSITIVE_INTEGER_INVALID"
msgstr "Ups! Das sieht nicht wie eine gültige Zahl aus. Bitte gib eine positive ganze Zahl ein. Keine Dezimalzahlen erlaubt!"

msgid "CommonMessages.TIME_PROMPT"
msgstr "Sende mir die Uhrzeit des Treffens im Format <i>HH:MM</i>"

msgid "CommonMessages.TIME_INVALID_VALUE"
msgstr "Meine innere Uhr ist alt und kann diese Science-Fiction-Zeit 🛸 nicht verstehen.\n\nVersuche es erneut mit einer Uhrzeit, die gültige Stunden (00-23) und Minuten (00-59) hat. Ich bin sicher, ich kann damit arbeiten 🧠."

msgid "CommonMessages.DATETIME_INPUT_INVALID"
msgstr "Ich habe in dieser Nachricht kein Datum und keine Uhrzeit gefunden. Wähle einen Tag im Kalender, sende die Uhrzeit im Format <i>HH:MM</i>, oder sende eine Nachricht mit ${datetime_link}, um Datum und Uhrzeit auf einmal festzulegen."

msgid "CommonMessages.DELETED_MEETING_ALERT"
msgstr "Dieses Treffen wurde gelöscht"

msgid "CommonMessages.UNEXPECTED_ERROR"
msgstr "Ups! Da ist etwas Unerwartetes passiert. Ich habe dich zum Hauptmenü zurückgebracht. Bitte versuche es erneut."

msgid "CommonMessages.UNEXPECTED_ERROR_ALERT"
msgstr "Bei uns ist etwas schiefgelaufen. Versuche es erneut, und schreibe an support@mitup.social, wenn es weiterhin passiert."

msgid "CommonMessages.ACCOUNT_NOT_FOUND"
msgstr "Du hast momentan kein Mitup-Konto. Sende /start und ich richte dich neu ein."

msgid "CommonMessages.BOT_BLOCKED_ALERT"
msgstr "Du hast mich blockiert, deshalb kann ich dir keine Nachrichten senden. Um Mitup wieder zu nutzen, hebe die Blockierung auf und sende /start."

msgid "CommonMessages.CONTEXT_LOST"
msgstr "<b>Entschuldigung, wir haben den Faden verloren!</b>\n\nDer Bot hatte ein kurzes internes Update und hat vergessen, wo du gerade warst. Alles, was du gespeichert hast, ist sicher. Bitte starte über das Menü unten noch einmal das, was du gerade gemacht hast."

msgid "CommonMessages.OLD_VERSION_MESSAGE"
msgstr "Diese Nachricht stammt aus einer älteren Version von Mitup, deshalb funktionieren ihre Buttons nicht mehr. Dein Konto und deine Treffen sind sicher. Öffne das Hauptmenü, um weiterzumachen."

msgid "CommonMessages.RICH_MESSAGE_NOT_SUPPORTED"
msgstr "<b>Das ist eine erweiterte Nachricht!</b>\n\nIch sehe, dass du eine gesendet hast, aber mit erweiterten Nachrichten kann ich nicht arbeiten, weil die Seiten der Treffen ihre eigene Formatierung haben. Sende deinen Text als normale Nachricht und wir machen weiter. Was du <b>fett</b> oder <i>kursiv</i> schreibst, kommt problemlos durch."

msgid "SupporterMessages.ACTIVE_MEETINGS_CAP"
msgstr "Du hast dein Limit von ${cap} aktiven Treffen erreicht. Beende oder lösche eines, um ein weiteres zu starten, oder werde Mitup-Host auf Patreon, um mehr freizuschalten. Alle Details findest du direkt unten unter Mithelfen."

msgid "SupporterMessages.ACTIVE_MEETINGS_CAP_PATRON"
msgstr "Dein Gamemaster-Plan erlaubt bis zu ${cap} aktive Treffen, danke, dass du Mitup unterstützt! Beende oder lösche eines, um ein weiteres zu starten, oder werde Commissioner auf Patreon, um das Limit aufzuheben. Alle Details findest du direkt unten unter Mithelfen."

msgid "SupporterMessages.SCHEDULING_HORIZON"
msgstr "Du kannst Treffen vorerst bis zu ${days} Tage im Voraus planen. Wähle ein früheres Datum, oder werde Mitup-Host auf Patreon, um noch weiter zu planen. Alle Details findest du direkt unten unter Mithelfen."

msgid "SupporterMessages.SCHEDULING_HORIZON_PATRON"
msgstr "Mit deinem Gamemaster-Plan kannst du bis zu ${days} Tage im Voraus planen, danke, dass du Mitup unterstützt! Wähle ein früheres Datum, oder werde Commissioner auf Patreon, um so weit zu planen, wie du möchtest. Alle Details findest du direkt unten unter Mithelfen."

msgid "SupporterMessages.SCHEDULING_HORIZON_TITLE"
msgstr "Dieses Datum liegt mehr als ${days} Tage voraus, weiter kannst du vorerst nicht planen. Sende den Titel deines Treffens noch einmal mit einem früheren Datum, oder werde Mitup-Host auf Patreon, um noch weiter zu planen. Alle Details findest du direkt unten unter Mithelfen."

msgid "SupporterMessages.SCHEDULING_HORIZON_TITLE_PATRON"
msgstr "Dieses Datum liegt mehr als ${days} Tage voraus, weiter reicht dein Gamemaster-Plan nicht. Sende den Titel deines Treffens noch einmal mit einem früheren Datum, oder werde Commissioner auf Patreon, um so weit zu planen, wie du möchtest. Alle Details findest du direkt unten unter Mithelfen."

msgid "SupporterMessages.PARTICIPANT_CAPACITY_EXCEEDED"
msgstr "Kostenlose Treffen können bis zu ${cap} Teilnehmer haben. Sende eine kleinere Zahl, oder werde Mitup-Host auf Patreon, um größere Treffen zu veranstalten: ${button_collaborate}"

msgid "RegistrationMessages.TIMEZONE_PROMPT"
msgstr "Willkommen bei Mitup Bot ${first_name}!\n\nBeginnen wir mit der Einstellung deiner Zeitzone. Sende mir den Namen deiner Stadt oder, für ein genaueres Ergebnis, deinen Standort, indem du auf 📎 tippst und Standort auswählst.\n\n<b>Wichtig</b>: Wir speichern deinen Standort nicht und diese Information wird nur zur Konfiguration deiner Zeitzone verwendet."

msgid "RegistrationMessages.REGISTRATION_COMPLETE"
msgstr "<b>Alles bereit, willkommen bei Mitup!</b> Deine Zeitzone ist ${timezone} und der Bot ist startklar für dich.\n\nAlles, was du brauchst, um Treffen zu erstellen und anderen beizutreten, findest du im Menü unten, und das ${user_guide} erklärt, wie alles funktioniert.\n\nWenn Mitup dir hilft, Leute zusammenzubringen, kannst du es jederzeit über Mithelfen unterstützen."

msgid "RegistrationMessages.USER_GUIDE_LABEL"
msgstr "Handbuch"

msgid "RegistrationMessages.TIMEZONE_FAIL"
msgstr "Es tut mir leid, ich konnte deine Zeitzone nicht festlegen. Bitte versuche es erneut."

msgid "RegistrationMessages.TIMEZONE_INVALID_INPUT"
msgstr "Bitte sende den Namen deiner Stadt als Text oder teile deinen Standort."

msgid "SettingsMessages.TIMEZONE_PROMPT"
msgstr "Deine Zeitzone ist auf <b>${timezone}</b> eingestellt.\nSende mir den Namen deiner Stadt oder deinen Standort, um deine Zeitzone zu ändern, oder tippe auf <b>Abbrechen</b>, um zurückzugehen."

msgid "SettingsMessages.TIMEZONE_SUCCESS"
msgstr "Deine Zeitzone wurde auf <b>${timezone}</b> eingestellt."

msgid "SettingsMessages.TIMEZONE_ON_EXIT"
msgstr "<i>Du warst gerade dabei, deine Zeitzone zu ändern.</i>\nSende den Namen deiner Stadt oder deinen Standort, um fortzufahren, oder tippe auf ${button_cancel}."

msgid "SettingsMessages.LANGUAGE_SUCCESS"
msgstr "Sprache eingestellt."

msgid "SettingsMessages.DEFAULT_OPTIONS_LEAD"
msgstr "Jedes Treffen, das du erstellst, startet mit diesen Einstellungen."

msgid "SettingsMessages.TOGGLE_HINT"
msgstr "Tippe auf den Status einer Einstellung, um sie ein- oder auszuschalten."

msgid "SettingsMessages.TIMEOUT_PROMPT"
msgstr "Sende das neue Timeout in Minuten, bis zu <b>${max_timeout}</b> (ein Tag), oder tippe auf Abbrechen, um zurückzugehen."

msgid "SettingsMessages.TIMEOUT_INVALID"
msgstr "Das sieht nicht wie ein gültiges Timeout aus. Sende eine positive ganze Zahl in Minuten, bis zu <b>${max_timeout}</b> (ein Tag). Keine Dezimalzahlen erlaubt!"

msgid "SettingsMessages.TIMEOUT_SUCCESS"
msgstr "Das Timeout wurde auf <b>${timeout} Minuten</b> eingestellt"

msgid "SettingsMessages.NOTIFICATIONS_TIME_PROMPT"
msgstr "Sende, wie lange vor dem Beginn eines Treffens (in Minuten) du benachrichtigt werden möchtest, oder tippe auf Abbrechen, um zurückzugehen."

msgid "SettingsMessages.NOTIFICATIONS_TIME_SUCCESS"
msgstr "Die Benachrichtigungszeit wurde auf <b>${notifications_time} Minuten</b> eingestellt."

msgid "PrivacyMessages.INTRO"
msgstr "Deine Daten gehören dir."

msgid "PrivacyMessages.POLICY_TITLE"
msgstr "Datenschutzerklärung"

msgid "PrivacyMessages.POLICY"
msgstr "Was Mitup über dich speichert, warum und wie lange."

msgid "PrivacyMessages.EXPORT_TITLE"
msgstr "Deine Daten"

msgid "PrivacyMessages.EXPORT"
msgstr "Lade eine Kopie von allem, was Mitup über dich speichert, als JSON-Datei herunter. Andere Personen in deinen Treffen erscheinen nur mit ihrem Anzeigenamen."

msgid "PrivacyMessages.EXPORT_ATTACHED"
msgstr "Deine Kopie ist an diese Nachricht angehängt."

msgid "PrivacyMessages.DELETE_TITLE"
msgstr "Löschung"

msgid "PrivacyMessages.DELETE"
msgstr "Entferne endgültig alles, was mit deinem Konto verknüpft ist. Treffen, die du erstellt hast, verschwinden für alle Teilnehmer."

msgid "PrivacyMessages.DELETE_WARNING"
msgstr "<b>Alle deine Daten löschen?</b>\n\nDadurch wird alles, was mit deinem Konto verknüpft ist, endgültig entfernt:\n\n- Treffen, die du erstellt hast, verschwinden für alle Teilnehmer, nicht nur für dich.\n- Du wirst aus jedem Treffen entfernt, an dem du teilnimmst.\n- Deine Einstellungen und deine Patreon-Verknüpfung werden gelöscht.\n\n<b>Es gibt kein Zurück.</b> Gelöschte Daten können nicht wiederhergestellt werden."

msgid "PrivacyMessages.DELETE_LAST_CHANCE"
msgstr "<b>Letzte Chance</b>\n\nWenn du jetzt bestätigst, funktioniert dein Konto sofort nicht mehr und die Löschung kann nicht mehr gestoppt werden.\n\nMöchtest du wirklich alle deine Daten endgültig löschen?"

msgid "PrivacyMessages.DELETION_MARKED"
msgstr "Deine Löschanfrage ist bestätigt und dein Konto funktioniert nicht mehr.\n\nInnerhalb eines Tages wird alles endgültig entfernt, und du erhältst eine letzte Nachricht zur Bestätigung der Löschung. Um Mitup danach wieder zu nutzen, sende den Befehl /start."

msgid "PrivacyMessages.PENDING_DELETION_ALERT"
msgstr "Dein Konto ist zur Löschung vorgemerkt und funktioniert nicht mehr. Du erhältst eine letzte Bestätigungsnachricht. Um Mitup danach wieder zu nutzen, sende den Befehl /start."

msgid "PrivacyMessages.DELETION_COMPLETE"
msgstr "<b>Deine Daten sind gelöscht</b>\n\nAlles, was mit deinem Konto verknüpft war, ist endgültig weg: die Treffen, die du erstellt hast, dein Platz in den Treffen, an denen du teilgenommen hast, und deine Einstellungen. Buttons auf älteren Nachrichten in diesem Chat funktionieren nicht mehr.\n\nUm Mitup wieder zu nutzen, sende den Befehl /start. Mitup weiß jetzt nichts mehr über dich und richtet dich neu ein."

msgid "MeetingCreationMessages.PROMPT"
msgstr "Lass uns ein Treffen erstellen. Wie lautet der Titel?\n\n<i>Tipp: Du kannst auch ${datetime_link} verwenden, um Datum und Uhrzeit direkt einzufügen.</i>"

msgid "MeetingCreationMessages.CREATED"
msgstr "Treffen erstellt: <b>${title}</b>\n\nDu kannst das Treffen mit den Optionen unten auf seiner Seite vervollständigen. Angaben, die du nicht ergänzt, werden beim Teilen des Treffens nicht angezeigt."

msgid "MeetingCreationMessages.INVALID_TITLE"
msgstr "Ich habe das, was du gesendet hast, nicht als gültigen Titel erkannt 🤔.\n\nSende eine Nachricht mit dem Titel des Treffens oder tippe auf <b>Abbrechen</b>."

msgid "MeetingCreationMessages.INVALID_TITLE_ENTITY"
msgstr "Ich verstehe nur einen Titel oder einen Titel mit einem Datum 🤔.\n\nBitte sende nur den Titel des Treffens oder den Titel mit einem von Telegram formatierten Datum. Tippe auf <b>Abbrechen</b>, um zu beenden."

msgid "MeetingCreationMessages.ON_EXIT"
msgstr "<i>Du warst gerade dabei, ein Treffen zu erstellen.</i>\nSende den Titel des Treffens, um fortzufahren, oder tippe auf ${button_cancel}."

msgid "MeetingCardSectionMessages.DESCRIPTION"
msgstr "Beschreibung"

msgid "MeetingCardSectionMessages.WHEN"
msgstr "Wann"

msgid "MeetingCardSectionMessages.WHERE"
msgstr "Wo"

msgid "MeetingCardSectionMessages.PARTICIPANTS"
msgstr "Teilnehmer"

msgid "MeetingCardSectionMessages.COUNT_OF_MAX"
msgstr "${count} von ${max}"

msgid "MeetingDisplayMessages.CREATED_BY"
msgstr "Erstellt von: ${owner}"

msgid "MeetingDisplayMessages.DATE_NOT_SET"
msgstr "🚫 Keine Uhrzeit festgelegt 🚫"

msgid "MeetingDisplayMessages.PARTICIPANT_COUNT_EMPTY"
msgstr "Leer"

msgid "MeetingDisplayMessages.MAX_PARTICIPANTS_LABEL"
msgstr "(Max: ${max_participants})"

msgid "MeetingDisplayMessages.PARTICIPANTS_TRUNCATED"
msgstr "${count} Namen nicht angezeigt"

msgid "MeetingDisplayMessages.INVITED_BY"
msgstr "<i>eingeladen von ${user}</i>"

msgid "MeetingDisplayMessages.NOT_PART_OF_MEETING"
msgstr "<i>Du nimmst nicht an diesem Treffen teil.</i>"

msgid "MeetingDisplayMessages.DESCRIPTION_EMPTY"
msgstr "<i>Dieses Treffen hat noch keine Beschreibung</i>"

msgid "MeetingDisplayMessages.UNTITLED"
msgstr "<i>Unbenanntes Treffen</i>"

msgid "MeetingDisplayMessages.IN_PROGRESS_STATUS"
msgstr "<i>Dieses Treffen läuft gerade.</i>"

msgid "MeetingDisplayMessages.FINISHED_STATUS"
msgstr "<i>Dieses Treffen ist vorbei.</i>"

msgid "MeetingDisplayMessages.DELETED_BANNER"
msgstr "🚫 Dieses Treffen wurde gelöscht 🚫"

msgid "MeetingDisplayMessages.FINISHED_BANNER"
msgstr "✅ Dieses Treffen ist beendet ✅"

msgid "MeetingDisplayMessages.BUILT_WITH"
msgstr "Gemacht mit ${mitup}"

msgid "MeetingJoinMessages.JOIN_SUCCESS"
msgstr "Du bist dem Treffen beigetreten!"

msgid "MeetingJoinMessages.JOIN_ALREADY_JOINED"
msgstr "Du bist diesem Treffen bereits beigetreten"

msgid "MeetingJoinMessages.JOIN_FULL"
msgstr "Entschuldigung! Das Treffen ist voll"

msgid "MeetingJoinMessages.JOIN_FULL_WAITING_LIST"
msgstr "Das Treffen ist voll. Du wurdest zur Warteliste hinzugefügt."

msgid "MeetingJoinMessages.JOIN_UNREGISTERED"
msgstr "Du bist dem Treffen beigetreten, ${user}! Es scheint, dass du Mitup noch nicht verwendet hast. Öffne einen Chat mit @mitupbot, um Benachrichtigungen zu erhalten und neue Treffen zu erstellen!"

msgid "MeetingJoinMessages.LEAVE_SUCCESS"
msgstr "Du hast das Treffen verlassen"

msgid "MeetingJoinMessages.LEAVE_NOT_JOINED"
msgstr "Du kannst ein Treffen nicht verlassen, dem du nicht beigetreten bist"

msgid "MeetingJoinMessages.LEAVE_UNREGISTERED"
msgstr "Du hast das Treffen verlassen, ${user}! Es scheint, dass du Mitup noch nicht verwendet hast. Öffne einen Chat mit @mitupbot, um Benachrichtigungen zu erhalten und neue Treffen zu erstellen!"

msgid "MeetingJoinMessages.PROMOTED_FROM_WAITING_LIST"
msgstr "Es gibt einen freien Platz im Treffen <b>${meeting_title}</b>. Du bist von der Warteliste nachgerückt!"

msgid "MeetingJoinMessages.JOIN_LOCKED"
msgstr "Dieses Treffen hat bereits begonnen und seine Teilnehmerliste ist gesperrt."

msgid "MeetingInviteMessages.ON_EXIT"
msgstr "<i>Du warst gerade dabei, jemanden einzuladen.</i>\nSende den Namen der Person, um fortzufahren, oder tippe auf ${button_cancel}."

msgid "MeetingInviteMessages.PROMPT"
msgstr "<b>Zur Gästeliste hinzufügen</b>\n\nBitte antworte mit dem Namen der Person, die du hinzufügen möchtest."

msgid "MeetingInviteMessages.CONFIRMATION"
msgstr "<b>Hinzufügen bestätigen</b>\n\nBist du sicher, dass du <b>${name}</b> zum Treffen <b>${meeting_title}</b> hinzufügen möchtest?"

msgid "MeetingInviteMessages.OPEN_CHAT"
msgstr "Privaten Chat starten\n\nUm Teilnehmer hinzuzufügen, musst du zunächst einen Chat mit mir öffnen."

msgid "MeetingInviteMessages.GO_PRIVATE"
msgstr "Weiter im privaten Chat\n\nBitte wechsle in unseren privaten Chat, um mir den Namen zu senden."

msgid "MeetingInviteMessages.SUCCESS"
msgstr "<b>Liste aktualisiert</b>\n\n<b>${name}</b> wurde zum Treffen <b>${meeting_title}</b> hinzugefügt."

msgid "MeetingInviteMessages.MEETING_FULL"
msgstr "Keine Plätze mehr\n\nDie Gästeliste ist derzeit voll. Du kannst niemanden hinzufügen, es sei denn, es wird ein Platz frei."

msgid "MeetingInviteMessages.INVITES_DISABLED"
msgstr "Gästeliste geschlossen\n\nFür dieses Treffen können keine Gäste mehr hinzugefügt werden. Der Veranstalter hat die Liste geschlossen."

msgid "MeetingInviteMessages.MEETING_NOT_FOUND"
