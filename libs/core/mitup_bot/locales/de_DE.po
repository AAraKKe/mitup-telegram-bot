msgid "MeetingListMessages.JOINED_EMPTY"
msgstr "<i>Du bist noch keinem Treffen beigetreten.</i>"

msgid "MeetingListMessages.PAST_DESCRIPTION"
msgstr "Dies sind alle deine vergangenen Treffen."

msgid "MeetingListMessages.PAST_EMPTY"
msgstr "<i>Du hast noch keine vergangenen Treffen.</i>"

