msgid "BroadcastOperatorMessages.UPLOAD_PROMPT"
msgstr "<b>Nova transmissão</b>\n\nEnvie um arquivo YAML ou cole o YAML direto em uma mensagem.\n\nEle precisa ser uma lista de entradas, cada uma com um código <code>language</code> e uma <code>message</code> em HTML. O inglês (<code>en</code>) é obrigatório como idioma de reserva."

msgid "BroadcastOperatorMessages.ERROR_INVALID_YAML"
msgstr "🚫 Não consegui interpretar isso como YAML.\n\n<code>${detail}</code>\n\nCorrija e envie novamente."

msgid "BroadcastOperatorMessages.ERROR_NOT_A_LIST"
msgstr "🚫 O conteúdo precisa ser uma lista de entradas, cada uma com um idioma e uma mensagem."

msgid "BroadcastOperatorMessages.ERROR_EMPTY_LIST"
msgstr "🚫 A lista está vazia. Adicione pelo menos uma entrada em inglês."

msgid "BroadcastOperatorMessages.ERROR_ENTRY_SHAPE"
msgstr "🚫 A entrada ${position} não é válida. Cada entrada precisa de exatamente dois campos: <code>language</code> e <code>message</code>, ambos em texto."

msgid "BroadcastOperatorMessages.ERROR_DUPLICATE_LANGUAGE"
msgstr "🚫 O idioma <b>${language}</b> aparece mais de uma vez. Deixe uma entrada por idioma."

msgid "BroadcastOperatorMessages.ERROR_MISSING_ENGLISH"
msgstr "🚫 O inglês (<code>${language}</code>) é obrigatório como idioma de reserva. Adicione uma entrada <code>en</code>."

msgid "BroadcastOperatorMessages.ERROR_EMPTY_MESSAGE"
msgstr "🚫 A mensagem de <b>${language}</b> está vazia."

msgid "BroadcastOperatorMessages.ERROR_MESSAGE_TOO_LONG"
msgstr "🚫 A mensagem de <b>${language}</b> tem ${length} caracteres, acima do limite de ${limit}. Encurte e envie novamente."

msgid "BroadcastOperatorMessages.ERROR_PREVIEW_REJECTED"
