msgstr "<i>Este evento ainda não tem descrição</i>"

msgid "MeetingDisplayMessages.UNTITLED"
msgstr "<i>Evento sem título</i>"

msgid "MeetingDisplayMessages.IN_PROGRESS_STATUS"
msgstr "<i>Este evento está em andamento.</i>"

msgid "MeetingDisplayMessages.FINISHED_STATUS"
msgstr "<i>Este evento terminou.</i>"

msgid "MeetingDisplayMessages.DELETED_BANNER"
msgstr "🚫 Este evento foi excluído 🚫"

msgid "MeetingDisplayMessages.FINISHED_BANNER"
msgstr "✅ Este evento terminou ✅"

msgid "MeetingDisplayMessages.BUILT_WITH"
msgstr "Feito com o ${mitup}"

msgid "MeetingJoinMessages.JOIN_SUCCESS"
msgstr "Participação confirmada!"

msgid "MeetingJoinMessages.JOIN_ALREADY_JOINED"
msgstr "Você já aceitou este evento"

msgid "MeetingJoinMessages.JOIN_FULL"
msgstr "Desculpe! O evento está cheio"

msgid "MeetingJoinMessages.JOIN_FULL_WAITING_LIST"
msgstr "O evento está cheio. Você entrou na lista de espera."

msgid "MeetingJoinMessages.JOIN_UNREGISTERED"
msgstr "Você entrou no evento, ${user}! Parece que você nunca usou o Mitup antes, abra um chat com @mitupbot para receber notificações e criar novos eventos!"

msgid "MeetingJoinMessages.LEAVE_SUCCESS"
msgstr "Você saiu do evento"

msgid "MeetingJoinMessages.LEAVE_NOT_JOINED"
msgstr "Você não pode recusar um evento que não aceitou"

msgid "MeetingJoinMessages.LEAVE_UNREGISTERED"
msgstr "Você saiu do evento, ${user}! Parece que você nunca usou o Mitup antes, abra um chat com @mitupbot para receber notificações e criar novos eventos!"

msgid "MeetingJoinMessages.PROMOTED_FROM_WAITING_LIST"
msgstr "Abriu uma vaga no evento <b>${meeting_title}</b>. Você saiu da lista de espera e sua participação está confirmada!"

msgid "MeetingJoinMessages.JOIN_LOCKED"
msgstr "Este evento já começou e a lista de participantes está bloqueada."

msgid "MeetingInviteMessages.ON_EXIT"
msgstr "<i>Você estava convidando alguém.</i>\nEnvie o nome da pessoa para continuar, ou toque em ${button_cancel} para sair."

msgid "MeetingInviteMessages.PROMPT"
msgstr "<b>Adicionar à lista de convidados</b>\n\nPor favor, responda com o nome da pessoa que você quer adicionar."

msgid "MeetingInviteMessages.CONFIRMATION"
msgstr "<b>Confirmar adição</b>\n\nTem certeza de que deseja adicionar <b>${name}</b> ao evento <b>${meeting_title}</b>?"

msgid "MeetingInviteMessages.OPEN_CHAT"
msgstr "Abrir chat privado\n\nPara adicionar participantes, você precisa abrir um chat comigo primeiro."

msgid "MeetingInviteMessages.GO_PRIVATE"
msgstr "Continuar no privado\n\nPor favor, mude para nosso chat privado para me enviar o nome."

msgid "MeetingInviteMessages.SUCCESS"
msgstr "<b>Lista atualizada</b>\n\nAdicionamos <b>${name}</b> ao evento <b>${meeting_title}</b>."

msgid "MeetingInviteMessages.MEETING_FULL"
msgstr "Sem vagas\n\nA lista de convidados está cheia. Você não pode adicionar mais ninguém, a menos que uma vaga abra."

msgid "MeetingInviteMessages.INVITES_DISABLED"
msgstr "Lista de convidados fechada\n\nNão é mais possível adicionar convidados a este evento. O organizador fechou a lista."

msgid "MeetingInviteMessages.MEETING_NOT_FOUND"
msgstr "Evento não encontrado\n\nO evento para o qual você está tentando convidar alguém não existe mais."

msgid "MeetingInviteMessages.FLOW_CONTEXT"
msgstr "Você estava no meio do processo de convidar alguém."

msgid "MeetingInviteMessages.CANCELED"
msgstr "O processo de convite foi cancelado."

msgid "MeetingInviteMessages.ADD_FAILED_RETRY"
msgstr "Algo inesperado aconteceu ao adicionar a pessoa convidada. Por favor, tente novamente."

msgid "MeetingLifecycleMessages.PAST_DESCRIPTION"
msgstr "Este evento não está mais ativo. Reative-o para compartilhá-lo novamente ou exclua-o permanentemente."

msgid "MeetingLifecycleMessages.REACTIVATE_SUCCESS"
msgstr "Evento reativado. Você pode editá-lo e compartilhá-lo novamente."

msgid "MeetingLifecycleMessages.DELETE_CONFIRMATION"
msgstr "Tem certeza de que deseja excluir este evento?"

