msgid "MeetingDisplayMessages.PARTICIPANTS_TRUNCATED"
msgstr "${count} nomes não mostrados"

msgid "MeetingDisplayMessages.INVITED_BY"
msgstr "<i>convite de ${user}</i>"

msgid "MeetingDisplayMessages.NOT_PART_OF_MEETING"
msgstr "<i>Você não faz parte deste evento.</i>"

