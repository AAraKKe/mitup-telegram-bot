msgstr "Hora definida para ${datetime}"

msgid "CommonMessages.TIME_INVALID_FORMAT"
msgstr "Não tenho certeza se entendi essa hora 🤔...\n\n"
"Por favor, envie a hora no formato <i>HH:MM</i>, por exemplo <i>15:30</i> ou <i>09:15</i>"

