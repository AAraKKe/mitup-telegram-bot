"Envie a localização do evento. Toque no ícone 📎 e escolha localização. Você pode enviar qualquer localização que quiser, não apenas sua localização atual."

msgid "MeetingEditLocationMessages.NAME_SUCCESS"
msgstr "Nome da localização definido para: <b>${name}</b>"

msgid "MeetingEditLocationMessages.COORDINATES_SUCCESS"
msgstr "Localização salva."

msgid "MeetingEditLocationMessages.COORDINATES_INVALID"
