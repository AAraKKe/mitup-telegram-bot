msgid "MeetingEditParticipantsMessages.KICK_OUT_SUCCESS"
msgstr "<b>${participant}</b> removido."

msgid "MeetingEditParticipantsMessages.KICK_OUT_SUCCESS_NO_MORE"
msgstr "<b>${participant}</b> removido. Não há mais participantes para gerenciar."

msgid "MeetingEditLanguageMessages.DESCRIPTION"
msgstr "Escolha o idioma do seu evento. Isso mudará o idioma usado ao compartilhar o evento.\n\nIdioma atual: <b>${language}</b>."

msgid "MeetingEditLanguageMessages.SUCCESS"
msgstr "Idioma definido."

msgid "MeetingLifecycleMessages.PAST_DESCRIPTION"
msgstr "Este evento não está mais ativo. Reative-o para compartilhá-lo novamente ou exclua-o permanentemente."

msgid "MeetingLifecycleMessages.REACTIVATE_SUCCESS"
msgstr "Evento reativado. Você pode editá-lo e compartilhá-lo novamente."

msgid "MeetingLifecycleMessages.DELETE_CONFIRMATION"
