msgid "MeetingEditParticipantsMessages.MAX_PROMPT_CAPPED"
msgstr "Envie o número máximo de membros permitidos no evento (deve ser um número maior que 0) ou toque em <i>Máx. (${cap})</i> para permitir o máximo do seu plano, ${cap} participantes."

msgid "MeetingEditParticipantsMessages.MAX_SUCCESS"
msgstr "Máx. de participantes definido para: <b>${max_participants}</b>"

msgid "MeetingEditParticipantsMessages.NO_LIMIT_LABEL"
msgstr "Sem limite"

msgid "MeetingEditParticipantsMessages.MAX_INVALID"
msgstr "O número máximo de participantes deve ser um número maior que 0. Por favor, tente novamente"

msgid "MeetingEditParticipantsMessages.KICK_OUT_DESCRIPTION"
msgstr "Estes são os usuários que se juntaram ao evento. Escolha quem você quer remover."

msgid "MeetingEditParticipantsMessages.KICK_OUT_CONFIRMATION"
msgstr "Tem certeza de que deseja remover <b>${participant}</b> do evento <b>${meeting_title}</b>?"

msgid "MeetingEditParticipantsMessages.KICK_OUT_NOT_IN_MEETING"
