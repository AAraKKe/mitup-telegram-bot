msgid "MeetingEditLocationMessages.DESCRIPTION"
msgstr "Um evento pode ter um local associado. Você pode simplesmente definir o nome do lugar ou enviar o local como anexo. Escolha qualquer uma das duas opções."

msgid "MeetingEditLocationMessages.NAME_PROMPT"
msgstr "Envie o nome do local."

msgid "MeetingEditLocationMessages.COORDINATES_PROMPT"
