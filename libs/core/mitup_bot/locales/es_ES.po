msgid "MeetingEditDateTimeMessages.TIME_DATE_DEFAULT_NOTE"
msgstr "La fecha se establece por defecto en hoy, pero puedes elegir otra."

msgid "MeetingEditDurationMessages.END_DATE_ADDED_TIME_PROMPT"
msgstr "La fecha de fin ha sido establecida a <b>${datetime}</b>. La hora se establece por defecto en 23:59.\n\nEnvía una hora en el formato <i>HH:MM</i> para cambiarla, o toca Hecho para mantener 23:59."

msgid "MeetingEditDateTimeMessages.DATE_UPDATED"
msgstr "La fecha de la quedada se ha establecido para el ${datetime}"

msgid "CommonMessages.TIME_PROMPT"
msgstr "Enviarme la hora de la quedada usando el formato <i>HH:MM</i> (por ejemplo, 21:30)"

msgid "MeetingEditDateTimeMessages.TIME_SUCCESS"
msgstr "La hora de la quedada se ha establecido para el ${datetime}"

msgid "CommonMessages.TIME_INVALID_FORMAT"
msgstr "No entiendo esa hora que me has enviado 🤔...\n\n"
"Por favor, envíame la hora de la quedada usando el formato <i>HH:MM</i>, por ejemplo <i>15:30</i> o <i>09:15</i>"

msgid "CommonMessages.TIME_INVALID_VALUE"
msgstr "Mi reloj interno es un poco antiguo y no entiende esa hora tan futurista 🛸.\n\n"
"Intenta de nuevo con una hora que tenga horas válidas (00-23) y minutos (00-59), ¡seguro que así me ubico mejor 🧠!"

msgid "MeetingDisplayMessages.DELETED_BANNER"
msgstr "🚫 Esta quedada ha sido eliminada 🚫"

msgid "MeetingDisplayMessages.FINISHED_BANNER"
msgstr "✅ Esta quedada ha finalizado ✅"

msgid "MeetingEditSettingsMessages.DESCRIPTION"
msgstr "Puedes configurar diferentes opciones en tu quedada:\n\n"
"<b>Lista de espera</b>: permite a tus contactos unirse a la quedada aunque esté llena. Los usuarios que se unan a la quedada una vez llena se añadirán a una lista de espera y serán aceptados como participantes en cuanto haya un hueco libre en el orden en el que se unieron.\n\n"
"<b>Pública</b>: activa esta opción para permitir reenviar tus quedadas a todos aquellos que la reciban. Una opción perfecta para llegar a más personas.\n\n"
"<b>Con invitación</b>: activa esta opción para que aquellos participantes en una quedada puedan añadir otros miembros, incluso si no tienen Telegram.\n\n"
"<b>Incógnito</b>: cuando activas incógnito en una quedada los participantes no se mostrarán cuando la compartas. Solo el número de participantes será visible. Tú sí podrás ver los participantes de la quedada."

msgid "MeetingAttachMessages.FOOTNOTE_INACTIVE"
msgstr "🔍 Haz que esta quedada sea buscable en este chat."

msgid "MeetingAttachMessages.FOOTNOTE_ACTIVE"
msgstr "✅ Esta quedada ahora es buscable en este chat."

msgid "MeetingAttachMessages.ENABLED_ALERT"
msgstr "✅ ¡Ahora es buscable!\n\nEsta quedada está ahora vinculada a este chat. Se incluirá en tus resultados de búsqueda cuando busques quedadas usando el modo inline del bot."

msgid "MeetingAttachMessages.ALREADY_ENABLED_ALERT"
msgstr "✅ ¡Ya es buscable!\n\nEsta quedada fue vinculada a este chat en un compartir anterior. Ya está incluida en tus resultados de búsqueda."

msgid "MeetingListMessages.ACTIVE_EMPTY"
msgstr "Aún no tienes ninguna quedada.\n\nSelecciona <b>${new_meeting_button}</b> en el menú principal para crear una."

msgid "MeetingListMessages.ACTIVE_DESCRIPTION"
msgstr "Estas son todas tus quedadas activas."

msgid "MeetingListMessages.JOINED_DESCRIPTION"
msgstr "Estas son las quedadas a las que te has unido."

msgid "MeetingListMessages.JOINED_EMPTY"
msgstr "<i>Todavía no te has unido a ninguna quedada.</i>"

msgid "MeetingListMessages.PAST_DESCRIPTION"
msgstr "Estas son todas tus quedadas pasadas."

msgid "MeetingListMessages.PAST_EMPTY"
msgstr "<i>Todavía no tienes ninguna quedada pasada.</i>"

