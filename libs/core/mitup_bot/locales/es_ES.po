msgid "HelpMessages.INTRO"
msgstr "Dónde encontrar ayuda con Mitup:"

msgid "HelpMessages.USER_GUIDE"
msgstr "La ${button_guide} recorre todas las pantallas, página a página. El mejor sitio para empezar."

msgid "HelpMessages.COMMUNITY_GROUP"
msgstr "El ${button_group} está abierto a cualquiera que use Mitup. Entra y pregunta lo que quieras."

msgid "HelpMessages.NEWS_CHANNEL"
msgstr "El ${button_channel} anuncia cada versión y lo que ha cambiado. Síguelo para enterarte antes que nadie."

msgid "HelpMessages.EMAIL"
msgstr "✉️ Para cualquier cosa privada, escribe a support@mitup.social. Lo lee una persona."

msgid "MeetingListMessages.ACTIVE_EMPTY_ALERT"
msgstr "No tienes quedadas activas. Toca Nueva quedada para crear una."

msgid "MeetingListMessages.JOINED_EMPTY_ALERT"
msgstr "Todavía no te has unido a ninguna quedada."

msgid "MeetingListMessages.PAST_EMPTY_ALERT"
msgstr "Todavía no tienes quedadas pasadas."

msgid "CommonMessages.STALE_CANCEL_ALERT"
msgstr "Ya has respondido esta pregunta"

msgid "CommonMessages.EDITING_REVAMP_BANNER"
msgstr "✨ ¡Hemos renovado la edición! Ahora todo se hace en la propia quedada."

msgid "CommonMessages.POSITIVE_INTEGER_INVALID"
msgstr "¡Vaya! Parece que ese no es un número válido. Por favor, envíame un número entero positivo. ¡No se permiten decimales!"

msgid "CommonMessages.TIME_PROMPT"
msgstr "Envíame la hora de la quedada en formato <i>HH:MM</i> (por ejemplo, 21:30)"

msgid "CommonMessages.TIME_INVALID_VALUE"
msgstr "Mi reloj interno es un poco antiguo y no entiende esa hora tan futurista 🛸.\n\nIntenta de nuevo con una hora que tenga horas válidas (00-23) y minutos (00-59), ¡seguro que así me ubico mejor 🧠!"

msgid "CommonMessages.DATETIME_INPUT_INVALID"
msgstr "No he encontrado ninguna fecha ni hora en ese mensaje. Elige un día en el calendario, envía la hora en formato <i>HH:MM</i>, o envía un mensaje usando ${datetime_link} para poner la fecha y la hora de una vez."

msgid "CommonMessages.DELETED_MEETING_ALERT"
msgstr "Esta quedada ha sido borrada"

msgid "CommonMessages.UNEXPECTED_ERROR"
msgstr "¡Uy! Ha pasado algo inesperado. Te he llevado de vuelta al menú principal. Por favor, inténtalo de nuevo."

msgid "CommonMessages.UNEXPECTED_ERROR_ALERT"
msgstr "Algo ha salido mal por nuestra parte. Por favor, inténtalo de nuevo. Si sigue pasando, escribe a support@mitup.social."

msgid "CommonMessages.ACCOUNT_NOT_FOUND"
msgstr "No tienes una cuenta de Mitup en este momento. Envía /start y me pondré a ello."

msgid "CommonMessages.BOT_BLOCKED_ALERT"
msgstr "Me has bloqueado, así que no puedo enviarte mensajes. Para usar Mitup de nuevo, desbloquéame y envía /start."

msgid "CommonMessages.CONTEXT_LOST"
msgstr "<b>¡Vaya, hemos perdido el hilo!</b>\n\nEl bot ha tenido una actualización interna y ha olvidado en qué paso estabas. Todo lo que guardaste está a salvo. Por favor, vuelve a empezar lo que estabas haciendo desde el menú de abajo."

msgid "CommonMessages.OLD_VERSION_MESSAGE"
msgstr "Este mensaje es de una versión antigua de Mitup, así que sus botones ya no funcionan. Tu cuenta y tus quedadas están a salvo. Abre el menú principal para continuar."

msgid "CommonMessages.RICH_MESSAGE_NOT_SUPPORTED"
msgstr "<b>¡Eso es un mensaje enriquecido!</b>\n\nVeo que has enviado uno, pero no puedo trabajar con mensajes enriquecidos, porque las páginas de las quedadas tienen su propio formato. Envíame tu texto como un mensaje normal y seguimos adelante. Cualquier <b>negrita</b> o <i>cursiva</i> que escribas sí me llega bien."

msgid "SupporterMessages.ACTIVE_MEETINGS_CAP"
msgstr "Has alcanzado tu límite de ${cap} quedadas activas. Cierra o elimina una para crear otra, o hazte Host de Mitup en Patreon para desbloquear más. Tienes todos los detalles en Colabora, justo debajo."

msgid "SupporterMessages.ACTIVE_MEETINGS_CAP_PATRON"
msgstr "Tu plan Gamemaster admite hasta ${cap} quedadas activas, ¡gracias por apoyar a Mitup! Cierra o elimina una para crear otra, o pásate a Commissioner en Patreon para eliminar el límite. Tienes todos los detalles en Colabora, justo debajo."

msgid "SupporterMessages.SCHEDULING_HORIZON"
msgstr "Por ahora puedes programar quedadas hasta ${days} días por adelantado. Elige una fecha más cercana, o hazte Host de Mitup en Patreon para programar con más antelación. Tienes todos los detalles en Colabora, justo debajo."

msgid "SupporterMessages.SCHEDULING_HORIZON_PATRON"
msgstr "Tu plan Gamemaster programa hasta ${days} días por adelantado, ¡gracias por apoyar a Mitup! Elige una fecha más cercana, o pásate a Commissioner en Patreon para programar con toda la antelación que quieras. Tienes todos los detalles en Colabora, justo debajo."

msgid "SupporterMessages.SCHEDULING_HORIZON_TITLE"
msgstr "Esa fecha está a más de ${days} días, la máxima antelación posible por ahora. Envía el título de tu quedada de nuevo con una fecha más cercana, o hazte Host de Mitup en Patreon para programar con más antelación. Tienes todos los detalles en Colabora, justo debajo."

msgid "SupporterMessages.SCHEDULING_HORIZON_TITLE_PATRON"
msgstr "Esa fecha está a más de ${days} días, la máxima antelación que permite tu plan Gamemaster. Envía el título de tu quedada de nuevo con una fecha más cercana, o pásate a Commissioner en Patreon para programar con toda la antelación que quieras. Tienes todos los detalles en Colabora, justo debajo."

msgid "SupporterMessages.PARTICIPANT_CAPACITY_EXCEEDED"
msgstr "Las quedadas gratuitas admiten hasta ${cap} participantes. Envía un número menor, o hazte Host de Mitup en Patreon para organizar quedadas más grandes: ${button_collaborate}"

msgid "RegistrationMessages.TIMEZONE_PROMPT"
msgstr "¡Te damos la bienvenida a Mitup Bot, ${first_name}!\n\nVamos a comenzar configurando tu zona horaria. Envíame el nombre de tu ciudad o, para un mejor resultado, tu ubicación tocando en 📎 y seleccionando Ubicación.\n\n<b>Importante</b>: no guardamos tu ubicación y solo se utiliza para encontrar la zona horaria."

msgid "RegistrationMessages.REGISTRATION_COMPLETE"
msgstr "<b>¡Todo listo, te damos la bienvenida a Mitup!</b> Tu zona horaria es ${timezone} y el bot está preparado para ti.\n\nTodo lo que necesitas para crear quedadas y unirte a otras está en el menú de abajo, y la ${user_guide} explica cómo funciona todo.\n\nSi Mitup te es de ayuda para reunirte con tu gente, puedes apoyarlo cuando quieras desde Colabora."

msgid "RegistrationMessages.USER_GUIDE_LABEL"
msgstr "guía de usuario"

msgid "RegistrationMessages.TIMEZONE_FAIL"
msgstr "Lo siento, no he podido establecer tu zona horaria. Por favor, inténtalo de nuevo."

msgid "RegistrationMessages.TIMEZONE_INVALID_INPUT"
msgstr "Por favor, envíame el nombre de tu ciudad como texto o comparte tu ubicación."

msgid "SettingsMessages.TIMEZONE_PROMPT"
msgstr "Tu zona horaria es <b>${timezone}</b>.\nEnvíame el nombre de tu ciudad o tu ubicación para configurar tu zona horaria o toca en <b>Cancelar</b> para volver."

msgid "SettingsMessages.TIMEZONE_SUCCESS"
msgstr "Tu zona horaria ha sido establecida a: <b>${timezone}</b>"

msgid "SettingsMessages.TIMEZONE_ON_EXIT"
msgstr "<i>Estabas cambiando tu zona horaria.</i>\nEnvíame el nombre de tu ciudad o tu ubicación para continuar, o toca ${button_cancel} para salir."

msgid "SettingsMessages.LANGUAGE_SUCCESS"
msgstr "El idioma se ha configurado correctamente."

msgid "SettingsMessages.DEFAULT_OPTIONS_LEAD"
msgstr "Cada quedada que creas empieza con estos ajustes."

msgid "SettingsMessages.TOGGLE_HINT"
msgstr "Toca el estado de un ajuste para activarlo o desactivarlo."

msgid "SettingsMessages.TIMEOUT_PROMPT"
msgstr "Envíame el nuevo tiempo de prórroga en minutos, hasta <b>${max_timeout}</b> (un día), o toca Cancelar para volver."

msgid "SettingsMessages.TIMEOUT_INVALID"
msgstr "¡Vaya! Ese no parece un tiempo de prórroga válido. Envíame un número entero positivo de minutos, hasta <b>${max_timeout}</b> (un día). ¡No se permiten decimales!"

msgid "SettingsMessages.TIMEOUT_SUCCESS"
msgstr "El tiempo de prórroga se ha guardado como <b>${duration}</b>"

msgid "SettingsMessages.NOTIFICATIONS_TIME_PROMPT"
msgstr "Envíame cuánto tiempo antes de que empiece una quedada (en minutos) te gustaría recibir una notificación o toca Cancelar para volver."

msgid "SettingsMessages.NOTIFICATIONS_TIME_SUCCESS"
msgstr "Listo. Recibirás las notificaciones <b>${duration}</b> antes de que comience cada quedada."

msgid "PrivacyMessages.INTRO"
msgstr "Tus datos son tuyos."

msgid "PrivacyMessages.POLICY_TITLE"
msgstr "Política de privacidad"

msgid "PrivacyMessages.POLICY"
msgstr "Qué guarda Mitup sobre ti, por qué y durante cuánto tiempo."

msgid "PrivacyMessages.EXPORT_TITLE"
msgstr "Tus datos"

msgid "PrivacyMessages.EXPORT"
msgstr "Descarga una copia de todo lo que Mitup guarda sobre ti, en un archivo JSON. Las demás personas de tus quedadas aparecen solo con su nombre visible."

msgid "PrivacyMessages.EXPORT_ATTACHED"
msgstr "Tu copia está adjunta a este mensaje."

msgid "PrivacyMessages.DELETE_TITLE"
msgstr "Borrado"

msgid "PrivacyMessages.DELETE"
msgstr "Elimina permanentemente todo lo vinculado a tu cuenta. Las quedadas que creaste desaparecen para todas las personas que se unieron."

msgid "PrivacyMessages.DELETE_WARNING"
msgstr "<b>¿Borrar todos tus datos?</b>\n\nEsto eliminará permanentemente todo lo vinculado a tu cuenta:\n\n- Las quedadas que creaste desaparecerán para todas las personas que se unieron, no solo para ti.\n- Saldrás de todas las quedadas a las que te uniste.\n- Tus ajustes y tu vínculo con Patreon se borrarán.\n\n<b>No hay vuelta atrás.</b> Los datos borrados no se pueden recuperar."

msgid "PrivacyMessages.DELETE_LAST_CHANCE"
msgstr "<b>Última oportunidad</b>\n\nSi confirmas ahora, tu cuenta dejará de funcionar inmediatamente y el borrado no se podrá detener.\n\n¿De verdad quieres borrar permanentemente todos tus datos?"

msgid "PrivacyMessages.DELETION_MARKED"
msgstr "Tu solicitud de borrado está confirmada y tu cuenta ha dejado de funcionar.\n\nTodo se eliminará permanentemente en el plazo de un día y recibirás un último mensaje confirmando el borrado. Para volver a usar Mitup, envía el comando /start."

msgid "PrivacyMessages.PENDING_DELETION_ALERT"
msgstr "Tu cuenta está programada para borrarse y ya no funciona. Recibirás un último mensaje de confirmación. Para volver a usar Mitup, envía el comando /start."

msgid "PrivacyMessages.DELETION_COMPLETE"
msgstr "<b>Tus datos están borrados</b>\n\nTodo lo vinculado a tu cuenta ha desaparecido permanentemente: las quedadas que creaste, tu plaza en las quedadas a las que te uniste y tus ajustes. Los botones de los mensajes antiguos de este chat ya no hacen nada.\n\nPara volver a usar Mitup, envía el comando /start. Mitup ya no tiene ningún recuerdo de ti y te configurará desde cero."

msgid "MeetingCreationMessages.PROMPT"
msgstr "Vamos a crear una quedada. Dime cuál será el título\n\n<i>Consejo: también puedes usar ${datetime_link} para incluir una fecha y hora directamente.</i>"

msgid "MeetingCreationMessages.CREATED"
msgstr "Quedada creada: <b>${title}</b>\n\nPuedes completar la quedada con las opciones que tienes aquí debajo. La información que no añadas no se mostrará cuando compartas la quedada."

msgid "MeetingCreationMessages.INVALID_TITLE"
msgstr "Creo que no entiendo el título que has enviado 🤔.\n\nEnvíame un mensaje con el título de la quedada o toca en <b>Cancelar</b>."

msgid "MeetingCreationMessages.INVALID_TITLE_ENTITY"
msgstr "Solo entiendo un título o un título con una fecha 🤔.\n\nPor favor, envía solo el título de la quedada, o el título con una fecha formateada por Telegram. Toca <b>Cancelar</b> para salir."

msgid "MeetingCreationMessages.ON_EXIT"
msgstr "<i>Estabas creando una quedada.</i>\nEnvíame el título de la quedada para continuar, o toca ${button_cancel} para salir."

msgid "MeetingCardSectionMessages.DESCRIPTION"
msgstr "Descripción"

msgid "MeetingCardSectionMessages.WHEN"
msgstr "Cuándo"

msgid "MeetingCardSectionMessages.WHERE"
msgstr "Dónde"

msgid "MeetingCardSectionMessages.PARTICIPANTS"
msgstr "Participantes"

msgid "MeetingCardSectionMessages.COUNT_OF_MAX"
msgstr "${count} de ${max}"

msgid "MeetingDisplayMessages.CREATED_BY"
msgstr "Creada por: ${owner}"

msgid "MeetingDisplayMessages.DATE_NOT_SET"
msgstr "🚫 Sin hora definida 🚫"

msgid "MeetingDisplayMessages.PARTICIPANT_COUNT_EMPTY"
msgstr "Sin participantes"

msgid "MeetingDisplayMessages.MAX_PARTICIPANTS_LABEL"
msgstr "(Máximo: ${max_participants})"

msgid "MeetingDisplayMessages.PARTICIPANTS_TRUNCATED"
msgstr "${count} nombres no mostrados"

msgid "MeetingDisplayMessages.INVITED_BY"
msgstr "<i>invitación de ${user}</i>"

msgid "MeetingDisplayMessages.NOT_PART_OF_MEETING"
msgstr "<i>No estás en esta quedada.</i>"

msgid "MeetingDisplayMessages.DESCRIPTION_EMPTY"
msgstr "<i>Esta quedada aún no tiene descripción</i>"

msgid "MeetingDisplayMessages.UNTITLED"
msgstr "<i>Quedada sin título</i>"

msgid "MeetingDisplayMessages.IN_PROGRESS_STATUS"
msgstr "<i>Esta quedada está en curso.</i>"

msgid "MeetingDisplayMessages.FINISHED_STATUS"
msgstr "<i>Esta quedada ha terminado.</i>"

msgid "MeetingDisplayMessages.DELETED_BANNER"
msgstr "🚫 Esta quedada ha sido eliminada 🚫"

msgid "MeetingDisplayMessages.FINISHED_BANNER"
msgstr "✅ Esta quedada ha finalizado ✅"

msgid "MeetingDisplayMessages.BUILT_WITH"
msgstr "Hecho con ${mitup}"

msgid "MeetingJoinMessages.JOIN_SUCCESS"
msgstr "¡Te has unido a la quedada!"

msgid "MeetingJoinMessages.JOIN_ALREADY_JOINED"
msgstr "Ya te habías unido a esta quedada"

msgid "MeetingJoinMessages.JOIN_FULL"
msgstr "¡Lo siento! La quedada ya está completa"

msgid "MeetingJoinMessages.JOIN_FULL_WAITING_LIST"
msgstr "La quedada está completa. Se te ha añadido a la lista de espera."

msgid "MeetingJoinMessages.JOIN_UNREGISTERED"
msgstr "¡Te has unido a la quedada, ${user}! Parece que es la primera vez que usas Mitup, abre un chat privado con @mitupbot para recibir notificaciones y crear nuevas quedadas."

msgid "MeetingJoinMessages.LEAVE_SUCCESS"
msgstr "Has abandonado la quedada"

msgid "MeetingJoinMessages.LEAVE_NOT_JOINED"
msgstr "No puedes dejar una quedada a la que no te has unido"

msgid "MeetingJoinMessages.LEAVE_UNREGISTERED"
msgstr "¡Has abandonado la quedada, ${user}! Parece que es la primera vez que usas Mitup, abre un chat privado con @mitupbot para recibir notificaciones y crear nuevas quedadas."

msgid "MeetingJoinMessages.PROMOTED_FROM_WAITING_LIST"
msgstr "Hay un hueco libre en la quedada <b>${meeting_title}</b>. ¡Te has unido desde la lista de espera!"

msgid "MeetingJoinMessages.JOIN_LOCKED"
msgstr "Esta quedada ya ha comenzado y su lista de asistentes está bloqueada."

msgid "MeetingInviteMessages.ON_EXIT"
msgstr "<i>Estabas invitando a alguien.</i>\nEnvíame el nombre de la persona para continuar, o toca ${button_cancel} para salir."

msgid "MeetingInviteMessages.PROMPT"
msgstr "<b>Añadir a la lista de invitados</b>\n\nPor favor, responde con el nombre de la persona que quieres añadir."

msgid "MeetingInviteMessages.CONFIRMATION"
msgstr "<b>Confirmar invitación</b>\n\n¿Estás seguro de que quieres añadir a <b>${name}</b> a la quedada <b>${meeting_title}</b>?"

msgid "MeetingInviteMessages.OPEN_CHAT"
msgstr "Abrir chat privado\n\nPara añadir participantes, necesitas abrir un chat conmigo primero."

msgid "MeetingInviteMessages.GO_PRIVATE"
msgstr "Continuar en privado\n\nPor favor, cambia a nuestro chat privado para enviarme el nombre."

msgid "MeetingInviteMessages.SUCCESS"
msgstr "<b>Lista actualizada</b>\n\nSe ha añadido a <b>${name}</b> a la quedada <b>${meeting_title}</b>."

msgid "MeetingInviteMessages.MEETING_FULL"
msgstr "No quedan plazas\n\nLa lista de invitados está completa. No puedes añadir a nadie más a menos que se libere una plaza."

msgid "MeetingInviteMessages.INVITES_DISABLED"
msgstr "Lista de invitados cerrada\n\nYa no se permiten más invitaciones para esta quedada. El organizador ha cerrado la lista."

msgid "MeetingInviteMessages.MEETING_NOT_FOUND"
msgstr "Quedada no encontrada\n\nLa quedada a la que intentas invitar a alguien ya no existe."

msgid "MeetingInviteMessages.FLOW_CONTEXT"
msgstr "Estabas invitando a alguien."

msgid "MeetingInviteMessages.CANCELED"
msgstr "El proceso de invitación ha sido cancelado."

msgid "MeetingInviteMessages.ADD_FAILED_RETRY"
msgstr "Algo inesperado ha pasado al añadir a la persona invitada. Por favor, inténtalo de nuevo."

msgid "MeetingLifecycleMessages.PAST_DESCRIPTION"
msgstr "Esta quedada ya no está activa. Reactívala para compartirla de nuevo o elimínala permanentemente."

msgid "MeetingLifecycleMessages.REACTIVATE_SUCCESS"
