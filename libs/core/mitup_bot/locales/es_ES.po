msgid "CommonMessages.DATETIME_INVALID"
msgstr "Toca <b>Fecha</b> u <b>Hora</b> para actualizarlas, o envía un mensaje con ${datetime_link} para establecer ambas a la vez."

msgid "MeetingEditDateTimeMessages.DATE_EDIT_PROMPT"
