msgid "BroadcastOperatorMessages.UPLOAD_PROMPT"
msgstr "<b>Nueva difusión</b>\n\nSube un archivo YAML o pega el YAML directamente en un mensaje.\n\nTiene que ser una lista de entradas, cada una con un código <code>language</code> y un <code>message</code> en HTML. El inglés (<code>en</code>) es obligatorio como idioma de respaldo."

msgid "BroadcastOperatorMessages.ERROR_INVALID_YAML"
msgstr "🚫 No he podido interpretar eso como YAML.\n\n<code>${detail}</code>\n\nCorrígelo y envíalo de nuevo."

msgid "BroadcastOperatorMessages.ERROR_NOT_A_LIST"
msgstr "🚫 El contenido tiene que ser una lista de entradas, cada una con un idioma y un mensaje."

msgid "BroadcastOperatorMessages.ERROR_EMPTY_LIST"
msgstr "🚫 La lista está vacía. Añade al menos una entrada en inglés."

msgid "BroadcastOperatorMessages.ERROR_ENTRY_SHAPE"
msgstr "🚫 La entrada ${position} no es válida. Cada entrada necesita exactamente dos campos: <code>language</code> y <code>message</code>, los dos de texto."

msgid "BroadcastOperatorMessages.ERROR_DUPLICATE_LANGUAGE"
msgstr "🚫 El idioma <b>${language}</b> aparece más de una vez. Deja una sola entrada por idioma."

msgid "BroadcastOperatorMessages.ERROR_MISSING_ENGLISH"
msgstr "🚫 El inglés (<code>${language}</code>) es obligatorio como idioma de respaldo. Añade una entrada <code>en</code>."

msgid "BroadcastOperatorMessages.ERROR_EMPTY_MESSAGE"
