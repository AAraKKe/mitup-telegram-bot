msgid "NotificationMessages.DELETION_WARNING"
msgstr "La quedada <b>${meeting_title}</b> será eliminada permanentemente en <b>${days_until_deletion} días</b>.\n\nPara evitar esto, puedes reactivar la quedada seleccionando el botón <b>${reactivate_meeting_button}</b> abajo.\n\nRecuerda que siempre puedes reactivar cualquier quedada pasada desde el botón <b>${past_meetings_button}</b> en el menú principal.\n\nSi no quieres reactivar la quedada, puedes ignorar este mensaje."

msgid "NotificationMessages.DELETED"
msgstr "La quedada <b>${meeting_title}</b> ha sido eliminada permanentemente."

msgid "NotificationMessages.STARTING_SOON"
msgstr "¡La quedada <b>${meeting_title}</b> va a comenzar pronto!"

msgid "NotificationMessages.STARTED"
msgstr "¡La quedada <b>${meeting_title}</b> ha comenzado!"

msgid "CollaborateMessages.NOT_LINKED"
msgstr "<b>Apoya a Mitup con Patreon</b>\n\nMitup es gratis. Si te ayuda a reunir a tu gente, puedes apoyarlo en Patreon y desbloquear ventajas de Host como agradecimiento.\n\n<b>Como Gamemaster:</b> organiza hasta ${active_meetings} quedadas activas a la vez, prográmalas hasta ${scheduling_days} días por adelantado e invita a un número ilimitado de participantes por quedada.\n\n<b>Como Commissioner:</b> sin límites.\n\nVincula tu cuenta de Patreon para empezar."

msgid "CollaborateMessages.LINKED_NOT_PATRON"
msgstr "<b>Cuenta de Patreon vinculada</b>\n\nTodo listo. Aún no eres Host, así que tus ventajas de Host siguen desactivadas.\n\n<b>Como Gamemaster:</b> organiza hasta ${active_meetings} quedadas activas a la vez, prográmalas hasta ${scheduling_days} días por adelantado e invita a un número ilimitado de participantes por quedada.\n\n<b>Como Commissioner:</b> sin límites.\n\nHazte Host y tus ventajas se activan automáticamente, sin necesidad de vincular de nuevo."

msgid "CollaborateMessages.LINKED_PATRON_SUPPORTER"
msgstr "<b>☕️ Ya eres Brewer</b>\n\nGracias por apoyar a Mitup. Tu insignia de Brewer aparece en tu perfil, y tu apoyo ayuda a mantener Mitup en marcha para todos. Puedes desvincular tu cuenta de Patreon cuando quieras."

msgid "CollaborateMessages.LINKED_PATRON_PATRON"
msgstr "<b>🎲 Ya eres Gamemaster</b>\n\nGracias por apoyar a Mitup. Tu insignia de Gamemaster está activa, y puedes organizar hasta ${active_meetings} quedadas activas a la vez, programarlas hasta ${scheduling_days} días por adelantado e invitar a un número ilimitado de participantes por quedada. Puedes desvincular tu cuenta de Patreon cuando quieras."

msgid "CollaborateMessages.LINKED_PATRON_ORGANIZER"
msgstr "<b>🏆 Ya eres Commissioner</b>\n\nGracias por apoyar a Mitup. Tu insignia de Commissioner está activa, y todos los límites desaparecen: organiza tantas quedadas como quieras, prográmalas con toda la antelación que necesites e invita a cuanta gente quieras a cada una. Puedes desvincular tu cuenta de Patreon cuando quieras."

msgid "CollaborateMessages.UNAVAILABLE"
msgstr "<b>Colabora</b>\n\nEl soporte de Patreon todavía no está disponible. Vuelve pronto."

msgid "CollaborateMessages.UNLINKED"
msgstr "Tu cuenta de Patreon se ha desvinculado."

msgid "CollaborateMessages.LINK_CONFIRMED_NO_PATRON"
msgstr "<b>Cuenta de Patreon vinculada</b>\n\nYa estás conectado. Hazte Host para desbloquear tus ventajas de Host. Se activarán solas en cuanto tu aportación esté activa."

