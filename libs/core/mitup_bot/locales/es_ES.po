msgid "SupporterMessages.ACTIVE_MEETINGS_CAP"
msgstr "Has alcanzado tu límite de ${cap} quedadas activas. Cierra o elimina una para crear otra, o pulsa Colabora en el menú principal para apoyar a Mitup y desbloquear más."

msgid "SupporterMessages.ACTIVE_MEETINGS_CAP_PATRON"
msgstr "Tu límite como Gamemaster es de ${cap} quedadas activas. Cierra o elimina una para crear otra, o pulsa Colabora en el menú principal para pasarte a Commissioner y eliminar el límite."

msgid "SupporterMessages.PARTICIPANT_CAPACITY"
msgstr "Las quedadas gratuitas admiten hasta ${cap} participantes. Elige un límite menor, o pulsa Colabora en el menú principal para apoyar a Mitup y admitir más."

msgid "SupporterMessages.SCHEDULING_HORIZON"
msgstr "Por ahora puedes programar quedadas hasta ${days} días por adelantado. Elige una fecha más cercana, o pulsa Colabora en el menú principal para apoyar a Mitup y programar más lejos."

msgid "SupporterMessages.SCHEDULING_HORIZON_PATRON"
msgstr "Tu plan Gamemaster te permite programar hasta ${days} días por adelantado. Elige una fecha más cercana, o pulsa Colabora en el menú principal para pasarte a Commissioner y eliminar el límite."

msgid "SupporterNotificationMessages.GRACE_STARTED"
msgstr "<b>Tus ventajas de Host están en periodo de gracia</b>\n\nNo hemos podido confirmar una aportación activa de Patreon en tu cuenta, así que tus ventajas de Host se desactivarán en una semana. Si tu aportación sigue activa, no tienes que hacer nada y se renovará automáticamente. Si no, puedes volver a apoyar a Mitup desde el menú Colabora."

msgid "SupporterNotificationMessages.SUPPORT_ENDED_GRACE"
msgstr "<b>Tus ventajas de Host están en periodo de gracia</b>\n\nTu apoyo en Patreon ha terminado y nos da pena verte marchar. Tus ventajas de Host seguirán activas durante ${days} días por si cambias de opinión. Para conservarlas, vuelve a apoyar a Mitup desde el menú Colabora."

msgid "SupporterNotificationMessages.SUPPORT_LOST"
msgstr "<b>Tus ventajas de Host han terminado</b>\n\nSeguimos sin poder confirmar una aportación activa de Patreon, así que tus ventajas de Host están ahora desactivadas. Hazte Host de nuevo desde el menú Colabora para reactivarlas."

msgid "SupporterNotificationMessages.SUPPORTER_UNLOCKED"
msgstr "<b>☕️ Ya eres Brewer</b>\n\nGracias por apoyar a Mitup. Tu insignia de Brewer ya aparece en tu perfil, y tu apoyo ayuda a mantener Mitup en marcha para todos."

msgid "SupporterNotificationMessages.PATRON_UNLOCKED"
msgstr "<b>🎲 Ya eres Gamemaster</b>\n\nGracias por apoyar a Mitup. Tu insignia de Gamemaster está activa y tus límites acaban de subir: organiza más quedadas a la vez, prográmalas con más antelación e invita a cuanta gente quieras a cada una."

msgid "SupporterNotificationMessages.ORGANIZER_UNLOCKED"
msgstr "<b>🏆 Ya eres Commissioner</b>\n\nGracias por apoyar a Mitup. Tu insignia de Commissioner está activa y todos los límites desaparecen: organiza tantas quedadas como quieras, prográmalas con toda la antelación que necesites e invita a cuanta gente quieras a cada una."

msgid "SupporterNotificationMessages.SUPPORTER_TIER_SET"
msgstr "<b>☕️ Tu nivel ahora es Brewer</b>\n\nTu insignia de Brewer sigue en tu perfil, y se aplican los límites estándar de quedadas: un número fijo de quedadas activas a la vez, la ventana de programación estándar y el tope estándar de participantes por quedada. Gracias por apoyar a Mitup."

msgid "SupporterNotificationMessages.PATRON_TIER_SET"
msgstr "<b>🎲 Tu nivel ahora es Gamemaster</b>\n\nTu insignia de Gamemaster está activa y se aplican tus límites de Gamemaster: organiza más quedadas a la vez, prográmalas con más antelación e invita a cuanta gente quieras a cada una. Gracias por apoyar a Mitup."

msgid "SupporterNotificationMessages.HOSTS_GROUP_REMOVED"
msgstr "<b>Tu acceso al Hosts-Only Group ha terminado</b>\n\nTu apoyo como Host ha llegado a su fin, y te agradecemos el tiempo que has respaldado a Mitup. Por ahora te hemos quitado del Hosts-Only Group. Cuando vuelvas a ser Host, podrás unirte de nuevo desde el menú Colabora."

msgid "SupporterNotificationMessages.HOSTS_GROUP_READMITTED"
msgstr "<b>Tu acceso de Host ha vuelto</b>\n\nBienvenido de nuevo. Tus ventajas de Host están activas otra vez, y eres bienvenido en el Hosts-Only Group. Toca abajo para volver a unirte."

