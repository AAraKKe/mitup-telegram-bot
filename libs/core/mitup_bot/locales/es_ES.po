msgid "MeetingEditLocationMessages.DESCRIPTION"
msgstr "Una quedada puede tener una ubicación asociada. Puedes indicar solo su nombre o también añadir la locación. Escoge cualquiera de las dos opciones."

msgid "MeetingEditLocationMessages.NAME_PROMPT"
msgstr "Envíame el nombre del lugar donde será la quedada."

msgid "MeetingEditLocationMessages.COORDINATES_PROMPT"
