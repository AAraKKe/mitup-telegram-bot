msgid "BroadcastOperatorMessages.UPLOAD_PROMPT"
msgstr "<b>Nuovo broadcast</b>\n\nCarica un file YAML, oppure incolla lo YAML direttamente in un messaggio.\n\nDeve essere una lista di voci, ognuna con un codice <code>language</code> e un <code>message</code> in HTML. L'inglese (<code>en</code>) è obbligatorio come lingua di riserva."

msgid "BroadcastOperatorMessages.ERROR_INVALID_YAML"
msgstr "🚫 Non sono riuscito a interpretarlo come YAML.\n\n<code>${detail}</code>\n\nCorreggilo e invialo di nuovo."

msgid "BroadcastOperatorMessages.ERROR_NOT_A_LIST"
msgstr "🚫 Il contenuto deve essere una lista di voci, ognuna con una lingua e un messaggio."

msgid "BroadcastOperatorMessages.ERROR_EMPTY_LIST"
msgstr "🚫 La lista è vuota. Aggiungi almeno una voce in inglese."

msgid "BroadcastOperatorMessages.ERROR_ENTRY_SHAPE"
msgstr "🚫 La voce ${position} non è valida. Ogni voce deve avere esattamente due campi: <code>language</code> e <code>message</code>, entrambi testo."

msgid "BroadcastOperatorMessages.ERROR_DUPLICATE_LANGUAGE"
msgstr "🚫 La lingua <b>${language}</b> compare più di una volta. Tieni una sola voce per lingua."

msgid "BroadcastOperatorMessages.ERROR_MISSING_ENGLISH"
msgstr "🚫 L'inglese (<code>${language}</code>) è obbligatorio come lingua di riserva. Aggiungi una voce <code>en</code>."

msgid "BroadcastOperatorMessages.ERROR_EMPTY_MESSAGE"
