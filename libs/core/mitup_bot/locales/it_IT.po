msgid "MeetingInviteMessages.PROMPT"
msgstr "<b>Aggiungi alla lista degli ospiti</b>\n\nPer favore, rispondi con il nome della persona che desideri aggiungere."

msgid "MeetingInviteMessages.CONFIRMATION"
msgstr "<b>Conferma aggiunta</b>\n\nSei sicuro di voler aggiungere <b>${name}</b> all'incontro <b>${meeting_title}</b>?"

msgid "MeetingInviteMessages.OPEN_CHAT"
msgstr "Avvia chat privata\n\nPer aggiungere partecipanti, devi prima aprire una chat con me."

msgid "MeetingInviteMessages.GO_PRIVATE"
msgstr "Continua in privato\n\nPer favore, passa alla nostra chat privata per inviarmi il nome."

msgid "MeetingInviteMessages.SUCCESS"
msgstr "<b>Lista aggiornata</b>\n\nL'utente <b>${name}</b> è stato aggiunto all'incontro <b>${meeting_title}</b>."

msgid "MeetingInviteMessages.MEETING_FULL"
msgstr "<b>Nessun posto libero</b>\n\nLa lista degli ospiti è attualmente piena. Non puoi aggiungere nessun altro a meno che non si liberi un posto."

msgid "MeetingInviteMessages.INVITES_DISABLED"
msgstr "<b>Lista degli ospiti chiusa</b>\n\nI nuovi aggiunti non sono più consentiti per questo incontro. L'organizzatore ha chiuso la lista."

msgid "MeetingInviteMessages.MEETING_LOST_RETRY"
msgstr "<b>È stato inaspettato...</b>\n\nHo perso improvvisamente traccia dei dettagli dell'incontro. Questo non dovrebbe accadere.\n\nPer favore, prova a inviare di nuovo il nome."

msgid "MeetingInviteMessages.MEETING_NOT_FOUND"
msgstr "<b>Incontro non trovato</b>\n\nL'incontro a cui stai cercando di invitare qualcuno non esiste più."

msgid "MeetingInviteMessages.CANCELED"
msgstr "Il processo di invito è stato annullato."

msgid "MeetingInviteMessages.ADD_FAILED_RETRY"
msgstr "Qualcosa di inaspettato è accaduto durante l'aggiunta dell'utente invitato. Per favore, riprova."

msgid "MeetingEditContentMessages.TITLE_PROMPT"
