msgid "HelpMessages.INTRO"
msgstr "Dove trovare aiuto con Mitup:"

msgid "HelpMessages.USER_GUIDE"
msgstr "La ${button_guide} spiega ogni schermata, pagina per pagina. Il punto migliore da cui iniziare."

msgid "HelpMessages.COMMUNITY_GROUP"
msgstr "Il ${button_group} è aperto a chiunque usi Mitup. Entra e chiedi quello che vuoi."

msgid "HelpMessages.NEWS_CHANNEL"
msgstr "Il ${button_channel} annuncia ogni nuova versione e cosa è cambiato. Seguilo per saperlo prima di tutti."

msgid "HelpMessages.EMAIL"
msgstr "✉️ Per qualsiasi cosa privata, scrivi a support@mitup.social. Dall'altra parte c'è una persona."

msgid "MeetingListMessages.ACTIVE_EMPTY_ALERT"
msgstr "Non hai incontri attivi. Tocca Nuovo incontro per crearne uno."

msgid "MeetingListMessages.JOINED_EMPTY_ALERT"
msgstr "Non partecipi ancora a nessun incontro."

msgid "MeetingListMessages.PAST_EMPTY_ALERT"
msgstr "Non hai ancora incontri passati."

msgid "CommonMessages.STALE_CANCEL_ALERT"
msgstr "Hai già risposto a questa domanda"

msgid "CommonMessages.EDITING_REVAMP_BANNER"
msgstr "✨ La modifica degli incontri si è rinnovata! Ora si fa tutto direttamente sulla scheda dell'incontro."

msgid "CommonMessages.POSITIVE_INTEGER_INVALID"
msgstr "Ops! Non sembra un numero valido. Per favore, inserisci un numero intero positivo. Non sono consentiti decimali!"

msgid "CommonMessages.TIME_PROMPT"
msgstr "Inviami l'ora dell'incontro nel formato <i>HH:MM</i>"

msgid "CommonMessages.TIME_INVALID_VALUE"
msgstr "Il mio orologio interno è vecchio e non può capire questa ora di fantascienza 🛸.\n\nRiprova con un orario che abbia ore valide (00-23) e minuti validi (00-59): con quello me la cavo di sicuro 🧠."

msgid "CommonMessages.DATETIME_INPUT_INVALID"
msgstr "Non ho trovato una data o un'ora in quel messaggio. Scegli un giorno dal calendario, invia l'ora nel formato <i>HH:MM</i>, oppure invia un messaggio usando ${datetime_link} per impostare data e ora in una volta sola."

msgid "CommonMessages.DELETED_MEETING_ALERT"
msgstr "Questo incontro è stato eliminato"

msgid "CommonMessages.UNEXPECTED_ERROR"
msgstr "Ops! Qualcosa di inaspettato è accaduto. Ti ho riportato al menu principale. Per favore, riprova."

msgid "CommonMessages.UNEXPECTED_ERROR_ALERT"
msgstr "Qualcosa è andato storto da parte nostra. Per favore, riprova e scrivi a support@mitup.social se il problema continua."

msgid "CommonMessages.ACCOUNT_NOT_FOUND"
msgstr "Non hai un account Mitup al momento. Invia /start e ti preparo tutto."

msgid "CommonMessages.BOT_BLOCKED_ALERT"
msgstr "Mi hai bloccato, quindi non posso inviarti messaggi. Per usare di nuovo Mitup, sbloccami e invia /start."

msgid "CommonMessages.CONTEXT_LOST"
msgstr "<b>Oops, abbiamo perso il filo!</b>\n\nIl bot ha ricevuto un rapido aggiornamento interno e ha dimenticato a che punto eri. Tutto quello che avevi salvato è al sicuro. Ricomincia quello che stavi facendo dal menu qui sotto."

msgid "CommonMessages.OLD_VERSION_MESSAGE"
msgstr "Questo messaggio proviene da una vecchia versione di Mitup e i suoi pulsanti non funzionano più. Il tuo account e i tuoi incontri sono al sicuro. Apri il menu principale per continuare."

msgid "CommonMessages.RICH_MESSAGE_NOT_SUPPORTED"
msgstr "<b>Questo è un messaggio avanzato!</b>\n\nVedo che ne hai inviato uno, ma non posso lavorare con i messaggi avanzati, perché le pagine degli incontri hanno una formattazione tutta loro. Inviami il tuo testo come messaggio semplice e andiamo avanti. Il <b>grassetto</b> e il <i>corsivo</i> che scrivi arrivano senza problemi."

msgid "SupporterMessages.ACTIVE_MEETINGS_CAP"
msgstr "Hai raggiunto il tuo limite di ${cap} incontri attivi. Chiudine o eliminane uno per crearne un altro, oppure diventa Host di Mitup su Patreon per sbloccarne altri. Trovi tutti i dettagli in Collabora, qui sotto."

msgid "SupporterMessages.ACTIVE_MEETINGS_CAP_PATRON"
msgstr "Il tuo piano Gamemaster ospita fino a ${cap} incontri attivi, grazie per sostenere Mitup! Chiudine o eliminane uno per crearne un altro, oppure diventa Commissioner su Patreon per rimuovere il limite. Trovi tutti i dettagli in Collabora, qui sotto."

msgid "SupporterMessages.SCHEDULING_HORIZON"
msgstr "Per ora puoi pianificare incontri fino a ${days} giorni in anticipo. Scegli una data più vicina, oppure diventa Host di Mitup su Patreon per pianificare con più anticipo. Trovi tutti i dettagli in Collabora, qui sotto."

msgid "SupporterMessages.SCHEDULING_HORIZON_PATRON"
msgstr "Il tuo piano Gamemaster pianifica fino a ${days} giorni in anticipo, grazie per sostenere Mitup! Scegli una data più vicina, oppure diventa Commissioner su Patreon per pianificare con tutto l'anticipo che vuoi. Trovi tutti i dettagli in Collabora, qui sotto."

msgid "SupporterMessages.SCHEDULING_HORIZON_TITLE"
msgstr "Quella data è a più di ${days} giorni di distanza, il massimo che puoi pianificare per ora. Invia di nuovo il titolo del tuo incontro con una data più vicina, oppure diventa Host di Mitup su Patreon per pianificare con più anticipo. Trovi tutti i dettagli in Collabora, qui sotto."

msgid "SupporterMessages.SCHEDULING_HORIZON_TITLE_PATRON"
msgstr "Quella data è a più di ${days} giorni di distanza, il massimo consentito dal tuo piano Gamemaster. Invia di nuovo il titolo del tuo incontro con una data più vicina, oppure diventa Commissioner su Patreon per pianificare con tutto l'anticipo che vuoi. Trovi tutti i dettagli in Collabora, qui sotto."

msgid "SupporterMessages.PARTICIPANT_CAPACITY_EXCEEDED"
msgstr "Con il piano gratuito un incontro può ospitare fino a ${cap} partecipanti. Invia un numero più basso, oppure diventa Host di Mitup su Patreon per organizzare incontri più grandi: ${button_collaborate}"

msgid "RegistrationMessages.TIMEZONE_PROMPT"
msgstr "Ti diamo il benvenuto su Mitup Bot, ${first_name}!\n\nIniziamo impostando il tuo fuso orario. Inviami il nome della tua città o, per un risultato più accurato, la tua posizione premendo su 📎 e selezionando Posizione.\n\n<b>Importante</b>: non memorizziamo la tua posizione e questa informazione viene utilizzata solo per configurare il tuo fuso orario."

msgid "RegistrationMessages.REGISTRATION_COMPLETE"
msgstr "<b>Tutto pronto, ti diamo il benvenuto su Mitup!</b> Il tuo fuso orario è ${timezone} e il bot è pronto per te.\n\nTutto quello che ti serve per creare incontri e partecipare ad altri è nel menu qui sotto, e la ${user_guide} spiega come funziona tutto.\n\nSe Mitup ti aiuta a riunire le persone, puoi sostenerlo quando vuoi tramite Collabora."

msgid "RegistrationMessages.USER_GUIDE_LABEL"
msgstr "guida utente"

msgid "RegistrationMessages.TIMEZONE_FAIL"
msgstr "Mi dispiace, non sono riuscito a impostare il tuo fuso orario. Per favore, riprova."

msgid "RegistrationMessages.TIMEZONE_INVALID_INPUT"
msgstr "Per favore, inviami il nome della tua città come testo o condividi la tua posizione."

msgid "SettingsMessages.TIMEZONE_PROMPT"
msgstr "Il tuo fuso orario è impostato su <b>${timezone}</b>.\nInviami il nome della tua città o la tua posizione per impostare il tuo fuso orario o tocca <b>Annulla</b> per tornare indietro."

msgid "SettingsMessages.TIMEZONE_SUCCESS"
msgstr "Il tuo fuso orario è stato impostato su: <b>${timezone}</b>"

msgid "SettingsMessages.TIMEZONE_ON_EXIT"
msgstr "<i>Stavi cambiando il tuo fuso orario.</i>\nInvia il nome della tua città o la tua posizione per continuare, oppure tocca ${button_cancel} per uscire."

msgid "SettingsMessages.LANGUAGE_SUCCESS"
msgstr "Lingua impostata."

msgid "SettingsMessages.DEFAULT_OPTIONS_LEAD"
msgstr "Ogni incontro che crei parte con queste impostazioni."

msgid "SettingsMessages.TOGGLE_HINT"
msgstr "Tocca lo stato di un'impostazione per attivarla o disattivarla."

msgid "SettingsMessages.TIMEOUT_PROMPT"
msgstr "Invia il nuovo timeout in minuti, fino a <b>${max_timeout}</b> (un giorno), oppure tocca Annulla per tornare indietro."

msgid "SettingsMessages.TIMEOUT_INVALID"
msgstr "Non sembra un timeout valido. Invia un numero intero positivo di minuti, fino a <b>${max_timeout}</b> (un giorno). Non sono consentiti decimali!"

msgid "SettingsMessages.TIMEOUT_SUCCESS"
msgstr "Timeout impostato a: <b>${timeout} minuti</b>"

msgid "SettingsMessages.NOTIFICATIONS_TIME_PROMPT"
msgstr "Inviami con quanto anticipo (in minuti) vuoi ricevere la notifica prima dell'inizio di un incontro, oppure tocca Annulla per tornare indietro."

msgid "SettingsMessages.NOTIFICATIONS_TIME_SUCCESS"
msgstr "Ora di notifica impostata a <b>${notifications_time} minuti</b>."

msgid "PrivacyMessages.INTRO"
msgstr "I tuoi dati sono tuoi."

msgid "PrivacyMessages.POLICY_TITLE"
msgstr "Informativa privacy"

msgid "PrivacyMessages.POLICY"
msgstr "Quali dati Mitup conserva su di te, perché e per quanto tempo."

msgid "PrivacyMessages.EXPORT_TITLE"
msgstr "I tuoi dati"

msgid "PrivacyMessages.EXPORT"
msgstr "Scarica una copia di tutto ciò che Mitup conserva su di te, in un file JSON. Le altre persone nei tuoi incontri compaiono solo con il nome visualizzato."

msgid "PrivacyMessages.EXPORT_ATTACHED"
msgstr "La tua copia è allegata a questo messaggio."

msgid "PrivacyMessages.DELETE_TITLE"
msgstr "Eliminazione"

msgid "PrivacyMessages.DELETE"
msgstr "Rimuovi definitivamente tutto ciò che è collegato al tuo account. Gli incontri che hai creato spariscono per tutti i partecipanti."

msgid "PrivacyMessages.DELETE_WARNING"
msgstr "<b>Eliminare tutti i tuoi dati?</b>\n\nQuesta operazione rimuoverà definitivamente tutto ciò che è collegato al tuo account:\n\n- Gli incontri che hai creato spariranno per tutti i partecipanti, non solo per te.\n- Ti rimuoveremo da tutti gli incontri a cui partecipi.\n- Le tue impostazioni e il tuo collegamento a Patreon verranno cancellati.\n\n<b>Non si può annullare.</b> I dati eliminati non possono essere recuperati."

msgid "PrivacyMessages.DELETE_LAST_CHANCE"
msgstr "<b>Ultima possibilità</b>\n\nSe confermi ora, il tuo account smette subito di funzionare e l'eliminazione non può essere fermata.\n\nVuoi davvero eliminare definitivamente tutti i tuoi dati?"

msgid "PrivacyMessages.DELETION_MARKED"
msgstr "La tua richiesta di eliminazione è confermata e il tuo account ha smesso di funzionare.\n\nTutto verrà rimosso definitivamente entro un giorno e riceverai un ultimo messaggio di conferma dell'eliminazione. Per usare di nuovo Mitup in seguito, invia il comando /start."

msgid "PrivacyMessages.PENDING_DELETION_ALERT"
msgstr "Il tuo account è in attesa di eliminazione e non funziona più. Riceverai un ultimo messaggio di conferma. Per usare di nuovo Mitup in seguito, invia il comando /start."

msgid "PrivacyMessages.DELETION_COMPLETE"
msgstr "<b>I tuoi dati sono stati eliminati</b>\n\nTutto ciò che era collegato al tuo account è sparito definitivamente: gli incontri che hai creato, il tuo posto negli incontri a cui partecipavi e le tue impostazioni. I pulsanti dei messaggi più vecchi in questa chat non fanno più nulla.\n\nPer usare di nuovo Mitup, invia il comando /start. Mitup ora non ha alcun ricordo di te e ti configurerà da zero."

msgid "MeetingCreationMessages.PROMPT"
msgstr "Creiamo un incontro. Qual è il titolo?\n\n<i>Suggerimento: puoi anche usare ${datetime_link} per includere una data e un'ora direttamente.</i>"

msgid "MeetingCreationMessages.CREATED"
msgstr "Incontro creato: <b>${title}</b>\n\nPuoi completare l'incontro con le opzioni sulla sua scheda qui sotto. Le informazioni che non hai aggiunto non compariranno quando condividi l'incontro."

msgid "MeetingCreationMessages.INVALID_TITLE"
msgstr "Non ho riconosciuto quello che hai inviato come titolo valido 🤔.\n\nInvia un messaggio con il titolo dell'incontro o fai clic su <b>Annulla</b>."

msgid "MeetingCreationMessages.INVALID_TITLE_ENTITY"
msgstr "Capisco solo un titolo o un titolo con una data 🤔.\n\nPer favore, invia solo il titolo dell'incontro, o il titolo con una data formattata da Telegram. Fai clic su <b>Annulla</b> per uscire."

msgid "MeetingCreationMessages.ON_EXIT"
msgstr "<i>Stavi creando un incontro.</i>\nInvia il titolo dell'incontro per continuare, oppure tocca ${button_cancel} per uscire."

msgid "MeetingCardSectionMessages.DESCRIPTION"
msgstr "Descrizione"

msgid "MeetingCardSectionMessages.WHEN"
msgstr "Quando"

msgid "MeetingCardSectionMessages.WHERE"
msgstr "Dove"

msgid "MeetingCardSectionMessages.PARTICIPANTS"
msgstr "Partecipanti"

msgid "MeetingCardSectionMessages.COUNT_OF_MAX"
msgstr "${count} di ${max}"

msgid "MeetingDisplayMessages.CREATED_BY"
msgstr "Creato da: ${owner}"

msgid "MeetingDisplayMessages.DATE_NOT_SET"
msgstr "🚫 Nessun orario definito 🚫"

msgid "MeetingDisplayMessages.PARTICIPANT_COUNT_EMPTY"
msgstr "Vuoto"

msgid "MeetingDisplayMessages.MAX_PARTICIPANTS_LABEL"
msgstr "(Max: ${max_participants})"

msgid "MeetingDisplayMessages.PARTICIPANTS_TRUNCATED"
msgstr "${count} nomi non mostrati"

msgid "MeetingDisplayMessages.INVITED_BY"
msgstr "<i>ospite di ${user}</i>"

msgid "MeetingDisplayMessages.NOT_PART_OF_MEETING"
msgstr "<i>Non partecipi a questo incontro.</i>"

msgid "MeetingDisplayMessages.DESCRIPTION_EMPTY"
msgstr "<i>Questo incontro non ha ancora una descrizione</i>"

msgid "MeetingDisplayMessages.UNTITLED"
msgstr "<i>Incontro senza titolo</i>"

msgid "MeetingDisplayMessages.IN_PROGRESS_STATUS"
msgstr "<i>Questo incontro è in corso.</i>"

msgid "MeetingDisplayMessages.FINISHED_STATUS"
msgstr "<i>Questo incontro è terminato.</i>"

msgid "MeetingDisplayMessages.DELETED_BANNER"
msgstr "🚫 Questo incontro è stato eliminato 🚫"

msgid "MeetingDisplayMessages.FINISHED_BANNER"
msgstr "✅ Questo incontro è terminato ✅"

msgid "MeetingDisplayMessages.BUILT_WITH"
msgstr "Fatto con ${mitup}"

msgid "MeetingJoinMessages.JOIN_SUCCESS"
msgstr "Sei dentro!"

msgid "MeetingJoinMessages.JOIN_ALREADY_JOINED"
msgstr "Partecipi già a questo incontro"

msgid "MeetingJoinMessages.JOIN_FULL"
msgstr "Mi dispiace! L'incontro è pieno"

msgid "MeetingJoinMessages.JOIN_FULL_WAITING_LIST"
msgstr "L'incontro è pieno. Ora sei in lista d'attesa."

msgid "MeetingJoinMessages.JOIN_UNREGISTERED"
msgstr "Ora partecipi all'incontro, ${user}! Sembra che tu non abbia mai usato Mitup prima: apri una chat con @mitupbot per ricevere notifiche e creare nuovi incontri!"

msgid "MeetingJoinMessages.LEAVE_SUCCESS"
msgstr "Hai abbandonato l'incontro"

msgid "MeetingJoinMessages.LEAVE_NOT_JOINED"
msgstr "Non puoi abbandonare un incontro a cui non partecipi"

msgid "MeetingJoinMessages.LEAVE_UNREGISTERED"
msgstr "Hai abbandonato l'incontro, ${user}! Sembra che tu non abbia mai usato Mitup prima: apri una chat con @mitupbot per ricevere notifiche e creare nuovi incontri!"

msgid "MeetingJoinMessages.PROMOTED_FROM_WAITING_LIST"
msgstr "Si è liberato un posto nell'incontro <b>${meeting_title}</b>: dalla lista d'attesa sei ora tra i partecipanti!"

msgid "MeetingJoinMessages.JOIN_LOCKED"
msgstr "Questo incontro è già iniziato e l'elenco dei partecipanti è bloccato."

msgid "MeetingInviteMessages.ON_EXIT"
msgstr "<i>Stavi invitando qualcuno.</i>\nInvia il nome della persona per continuare, oppure tocca ${button_cancel} per uscire."

msgid "MeetingInviteMessages.PROMPT"
msgstr "<b>Aggiungi alla lista degli ospiti</b>\n\nPer favore, rispondi con il nome della persona che desideri aggiungere."

msgid "MeetingInviteMessages.CONFIRMATION"
msgstr "<b>Conferma aggiunta</b>\n\nVuoi davvero aggiungere <b>${name}</b> all'incontro <b>${meeting_title}</b>?"

msgid "MeetingInviteMessages.OPEN_CHAT"
msgstr "Avvia chat privata\n\nPer aggiungere partecipanti, devi prima aprire una chat con me."

msgid "MeetingInviteMessages.GO_PRIVATE"
msgstr "Continua in privato\n\nPer favore, passa alla nostra chat privata per inviarmi il nome."

msgid "MeetingInviteMessages.SUCCESS"
msgstr "<b>Lista aggiornata</b>\n\nAbbiamo aggiunto <b>${name}</b> all'incontro <b>${meeting_title}</b>."

msgid "MeetingInviteMessages.MEETING_FULL"
msgstr "Nessun posto libero\n\nLa lista degli ospiti è attualmente piena. Non puoi aggiungere nessun altro a meno che non si liberi un posto."

msgid "MeetingInviteMessages.INVITES_DISABLED"
msgstr "Lista degli ospiti chiusa\n\nNon si possono più aggiungere persone a questo incontro. L'organizzatore ha chiuso la lista."

msgid "MeetingInviteMessages.MEETING_NOT_FOUND"
msgstr "Incontro non trovato\n\nL'incontro a cui stai cercando di invitare qualcuno non esiste più."

msgid "MeetingInviteMessages.FLOW_CONTEXT"
msgstr "Stavi invitando qualcuno."

msgid "MeetingInviteMessages.CANCELED"
msgstr "Invito annullato."

msgid "MeetingInviteMessages.ADD_FAILED_RETRY"
msgstr "Qualcosa di inaspettato è successo mentre aggiungevo la persona invitata. Per favore, riprova."

msgid "MeetingLifecycleMessages.PAST_DESCRIPTION"
