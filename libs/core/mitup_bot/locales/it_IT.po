msgid "MeetingEditContentMessages.DESCRIPTION_PROMPT"
msgstr "Questa è la descrizione attuale del tuo incontro:\n${description}\n\nInviami la nuova"

msgid "MeetingEditContentMessages.TITLE_SUCCESS"
msgstr "Titolo aggiornato a: <b>${title}</b>"

msgid "MeetingEditContentMessages.DESCRIPTION_SUCCESS"
msgstr "Descrizione aggiornata a: <b>${description}</b>"

msgid "MeetingEditLocationMessages.DESCRIPTION"
msgstr "Un incontro può avere un luogo associato. Puoi semplicemente impostare il nome del posto o puoi anche allegarlo. Scegli una qualsiasi delle due opzioni."

msgid "MeetingEditLocationMessages.NAME_PROMPT"
msgstr "Inviami il nome del luogo."

msgid "MeetingEditLocationMessages.COORDINATES_PROMPT"
msgstr "<i>Solo dal telefono 📱</i>\n\nInvia la posizione dell'incontro. Tocca l'icona 📎 e quindi scegli posizione. Puoi inviare qualsiasi posizione desideri, non solo la tua posizione attuale."

msgid "MeetingEditLocationMessages.NAME_SUCCESS"
msgstr "Nome della posizione impostato su: <b>${name}</b>"

msgid "MeetingEditLocationMessages.COORDINATES_SUCCESS"
msgstr "Posizione salvata."

msgid "MeetingEditLocationMessages.COORDINATES_INVALID"
msgstr "Inviami di nuovo la posizione. Ricorda di toccare l'icona a forma di graffetta e scegliere posizione."

msgid "MeetingEditParticipantsMessages.DESCRIPTION"
msgstr "Qui potrai gestire i partecipanti dell'incontro: puoi impostare il numero massimo di persone che possono partecipare all'incontro nonché cacciare qualsiasi partecipante dell'incontro."

msgid "MeetingEditParticipantsMessages.MAX_PROMPT"
msgstr "Inviami il numero massimo di membri consentiti nell'incontro (deve essere un numero maggiore di 0) o premi su <i>Senza limiti</i> per consentire un numero illimitato di partecipanti."

msgid "MeetingEditParticipantsMessages.MAX_SUCCESS"
msgstr "Il numero massimo di partecipanti è stato impostato su: <b>${max_participants}</b>"

msgid "MeetingEditParticipantsMessages.NO_LIMIT_LABEL"
msgstr "Senza limiti"

msgid "MeetingEditParticipantsMessages.MAX_INVALID"
msgstr "Il numero massimo di partecipanti deve essere un numero maggiore di 0. Per favore, riprova"

msgid "MeetingEditParticipantsMessages.KICK_OUT_DESCRIPTION"
msgstr "Questi sono gli utenti che si sono uniti all'incontro. Scegli chi vuoi cacciare."

msgid "MeetingLifecycleMessages.DELETE_CONFIRMATION"
msgstr "Sei sicuro di voler eliminare questo incontro?"

msgid "MeetingLifecycleMessages.DELETE_SUCCESS"
msgstr "Incontro eliminato."

msgid "MeetingLifecycleMessages.DELETE_DECLINED"
msgstr "L'incontro non sarà eliminato"

msgid "CommonMessages.DELETED_MEETING_ALERT"
msgstr "Questo incontro è stato eliminato"

msgid "CommonMessages.UNEXPECTED_ERROR"
msgstr "Oops! Qualcosa di inaspettato è accaduto. Ti ho riportato al menu principale. Per favore, riprova."

msgid "MeetingEditDateTimeMessages.DESCRIPTION"
msgstr "Scegli cosa vuoi impostare per il tuo incontro.\n\n<i>Suggerimento: puoi anche inviare un messaggio utilizzando ${datetime_link} per impostare la data e l'ora contemporaneamente.</i>"

msgid "CommonMessages.DATETIME_INVALID"
msgstr "Tocca <b>Data</b> o <b>Ora</b> per aggiornarle, o invia un messaggio con ${datetime_link} per impostare entrambe contemporaneamente."

msgid "MeetingEditDateTimeMessages.DATE_EDIT_PROMPT"
msgstr "Seleziona la nuova data. Premi <b>🗑️ Elimina data</b> se desideri annullare la data e l'ora dell'incontro."

msgid "MeetingEditDateTimeMessages.DATE_ADD_PROMPT"
msgstr "Seleziona la data."

msgid "MeetingEditDateTimeMessages.DATE_ADDED_TIME_PROMPT"
msgstr "La data è stata impostata a <b>${datetime}</b>. L'ora è predefinita alle 23:59, poco prima di mezzanotte.\n\nInvia un'ora diversa nel formato <i>HH:MM</i>, oppure tocca Fine per mantenere 23:59."

msgid "MeetingEditDateTimeMessages.TIME_DATE_DEFAULT_NOTE"
msgstr "La data predefinita è oggi, ma puoi impostarne una diversa."

msgid "MeetingEditDurationMessages.END_DATE_ADDED_TIME_PROMPT"
msgstr "La data di fine è stata impostata a <b>${datetime}</b>. L'ora è predefinita alle 23:59.\n\nInvia l'ora nel formato <i>HH:MM</i> per cambiarla, oppure tocca Fine per mantenere 23:59."

msgid "MeetingEditDateTimeMessages.DATE_UPDATED"
msgstr "Data impostata a: ${datetime}"

msgid "CommonMessages.TIME_PROMPT"
msgstr "Inviami l'ora dell'incontro nel formato <i>HH:MM</i>"

msgid "MeetingEditDateTimeMessages.TIME_SUCCESS"
msgstr "Ora impostata a ${datetime}"

msgid "MeetingEditDateTimeMessages.START_IN_PAST"
msgstr "L'orario di inizio deve essere nel futuro."

msgid "CommonMessages.TIME_INVALID_FORMAT"
msgstr "Non sono sicuro di capire quell'ora 🤔...\n\nPer favore, invia l'ora nel formato <i>HH:MM</i>, ad esempio <i>15:30</i> o <i>09:15</i>"

msgid "CommonMessages.TIME_INVALID_VALUE"
msgstr "Il mio orologio interno è vecchio e non può capire questa ora di fantascienza 🛸.\n\nRiprova con un'ora che ha ore valide (00-23) e minuti (00-59), sono sicuro di poter lavorare con quello 🧠."

msgid "MeetingDisplayMessages.DELETED_BANNER"
msgstr "🚫 Questo incontro è stato eliminato 🚫"

msgid "MeetingDisplayMessages.FINISHED_BANNER"
