msgid "CommonMessages.CONTEXT_LOST"
msgstr "<b>Opa, perdemos o fío!</b>\n\nO bot tivo unha actualización interna rápida e esqueceu en que punto do proceso estabas. Todo o que gardaches está a salvo. Por favor, comeza de novo o que estabas a facer desde o menú de abaixo."

msgid "CommonMessages.RICH_MESSAGE_NOT_SUPPORTED"
msgstr "<b>Iso é unha mensaxe enriquecida!</b>\n\nVexo que enviaches unha, pero aínda non podo traballar con mensaxes enriquecidas. A compatibilidade chega coa actualización v2.0, e anunciarei acó cando chegue, así que atende. Pola agora, envía o teu texto como unha mensaxe normal e seguiremos."

msgid "SupporterMessages.ACTIVE_MEETINGS_CAP"
msgstr "Alcanzaches o teu límite de ${cap} quedadas activas. Pecha ou elimina unha para crear outra, ou faite Host de Mitup en Patreon para desbloquear máis. Tes todos os detalles en Colabora, xusto debaixo."

msgid "SupporterMessages.ACTIVE_MEETINGS_CAP_PATRON"
msgstr "O teu plan Gamemaster admite ata ${cap} quedadas activas, grazas por apoiar a Mitup! Pecha ou elimina unha para crear outra, ou pasa a Commissioner en Patreon para eliminar o límite. Tes todos os detalles en Colabora, xusto debaixo."

msgid "SupporterMessages.PARTICIPANT_CAPACITY"
msgstr "As quedadas gratuitas admiten ata ${cap} participantes. Envía un número menor, ou faite Host de Mitup en Patreon para organizar quedadas máis grandes. Tes todos os detalles en Colabora, xusto debaixo."

msgid "SupporterMessages.SCHEDULING_HORIZON"
msgstr "Por agora podes programar quedadas ata ${days} días por diante. Escolle unha data máis próxima, ou faite Host de Mitup en Patreon para programar máis lonxe. Tes todos os detalles en Colabora, xusto debaixo."

msgid "SupporterMessages.SCHEDULING_HORIZON_PATRON"
msgstr "O teu plan Gamemaster programa ata ${days} días por diante, grazas por apoiar a Mitup! Escolle unha data máis próxima, ou pasa a Commissioner en Patreon para programar tan lonxe como queiras. Tes todos os detalles en Colabora, xusto debaixo."

msgid "SupporterNotificationMessages.GRACE_STARTED"
msgstr "<b>Os teus privilexios de Host están nun período de graza</b>\n\nNon puidemos confirmar unha achega activa de Patreon na túa conta, así que os teus privilexios de Host desactivaranse nunha semana. Se a túa achega segue activa, non tes que facer nada e renovarase automaticamente. En caso contrario, podes volver apoiar Mitup desde o menú Colabora."

msgid "SupporterNotificationMessages.SUPPORT_ENDED_GRACE"
msgstr "<b>Os teus privilexios de Host están nun período de graza</b>\n\nO teu apoio en Patreon rematou, e sentímolo moito. Os teus privilexios de Host seguirán activos durante ${days} días por se cambias de idea. Para mantelos, volve apoiar Mitup desde o menú Colabora."

msgid "SupporterNotificationMessages.SUPPORT_LOST"
msgstr "<b>Os teus privilexios de Host remataron</b>\n\nSeguimos sen poder confirmar unha achega activa de Patreon, así que os teus privilexios de Host están agora desactivados. Faite Host de novo desde o menú Colabora para reactivalos."

msgid "SupporterNotificationMessages.SUPPORTER_UNLOCKED"
msgstr "<b>☕️ Xa es Brewer</b>\n\nGrazas por apoiar Mitup. A túa insignia de Brewer xa aparece no teu perfil, e o teu apoio axuda a manter Mitup en marcha para todos."

msgid "SupporterNotificationMessages.PATRON_UNLOCKED"
msgstr "<b>🎲 Xa es Gamemaster</b>\n\nGrazas por apoiar Mitup. A túa insignia de Gamemaster está activa e os teus límites acaban de subir: organiza máis quedadas á vez, prográmaas con máis antelación e convida a cantas persoas queiras a cada unha."

msgid "SupporterNotificationMessages.ORGANIZER_UNLOCKED"
msgstr "<b>🏆 Xa es Commissioner</b>\n\nGrazas por apoiar Mitup. A túa insignia de Commissioner está activa e desaparecen todos os límites: organiza cantas quedadas queiras, prográmaas con toda a antelación que precises e convida a cantas persoas queiras a cada unha."

msgid "SupporterNotificationMessages.SUPPORTER_TIER_SET"
msgstr "<b>☕️ Agora o teu nivel é Brewer</b>\n\nA túa insignia de Brewer segue no teu perfil, e aplícanse os límites estándar das quedadas: un número fixo de quedadas activas á vez, o período de programación estándar e o tope estándar de participantes por quedada. Grazas por apoiar Mitup."

msgid "SupporterNotificationMessages.PATRON_TIER_SET"
msgstr "<b>🎲 Agora o teu nivel é Gamemaster</b>\n\nA túa insignia de Gamemaster está activa e aplícanse os teus límites de Gamemaster: organiza máis quedadas á vez, prográmaas con máis antelación e convida a cantas persoas queiras a cada unha. Grazas por apoiar Mitup."

msgid "SupporterNotificationMessages.HOSTS_GROUP_REMOVED"
msgstr "<b>O teu acceso ao Hosts-Only Group rematou</b>\n\nO teu apoio como Host chegou á súa fin, e agradecémosche moito o tempo que apoiaches Mitup. Por agora sacámoste do Hosts-Only Group. Cando volvas ser Host, podes volver unirte a el desde o menú Colabora."

msgid "SupporterNotificationMessages.HOSTS_GROUP_READMITTED"
