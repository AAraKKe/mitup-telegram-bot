msgid "MeetingEditParticipantsMessages.MAX_PROMPT"
msgstr "Envíame o número máximo de membros permitidos na quedada (debe ser un número maior que 0) ou preme en <i>Sen límite</i> para permitir un número ilimitado de participantes."

msgid "MeetingEditParticipantsMessages.MAX_PROMPT_CAPPED"
msgstr "Envíame o número máximo de membros permitidos na quedada (debe ser un número maior que 0) ou preme <i>Máx. (${cap})</i> para permitir o máximo do teu plan, ${cap} participantes."

msgid "MeetingEditParticipantsMessages.MAX_SUCCESS"
msgstr "O número máximo de participantes estableceuse a: <b>${max_participants}</b>"

msgid "MeetingEditParticipantsMessages.NO_LIMIT_LABEL"
msgstr "Sen límite"

msgid "MeetingEditParticipantsMessages.MAX_INVALID"
msgstr "O número máximo de participantes debe ser un número maior que 0. Por favor intenta de novo"

msgid "MeetingEditParticipantsMessages.KICK_OUT_DESCRIPTION"
msgstr "Estes son os usuarios que se uniron á quedada. Elixe a quen queres botar."

msgid "MeetingEditParticipantsMessages.KICK_OUT_CONFIRMATION"
