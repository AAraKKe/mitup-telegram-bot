msgid "HelpMessages.INTRO"
msgstr "Onde atopar axuda con Mitup:"

msgid "HelpMessages.USER_GUIDE"
msgstr "A ${button_guide} percorre todas as pantallas, páxina a páxina. O mellor sitio para comezar."

msgid "HelpMessages.COMMUNITY_GROUP"
msgstr "O ${button_group} está aberto a calquera persoa que use Mitup. Entra e pregunta o que queiras."

msgid "HelpMessages.NEWS_CHANNEL"
msgstr "A ${button_channel} anuncia cada nova versión e os cambios que trae. Séguea para sabelo antes ca ninguén."

msgid "HelpMessages.EMAIL"
msgstr "✉️ Para calquera cousa privada, escribe a support@mitup.social. Hai unha persoa que le eses correos."

msgid "MeetingListMessages.ACTIVE_EMPTY_ALERT"
msgstr "Non tes ningunha quedada activa. Toca Nova quedada para crear unha."

msgid "MeetingListMessages.JOINED_EMPTY_ALERT"
msgstr "Aínda non te uniches a ningunha quedada."

msgid "MeetingListMessages.PAST_EMPTY_ALERT"
msgstr "Aínda non tes quedadas pasadas."

msgid "CommonMessages.STALE_CANCEL_ALERT"
msgstr "Xa respondiches a esta pregunta"

msgid "CommonMessages.EDITING_REVAMP_BANNER"
msgstr "✨ Renovamos a edición! Agora todo se fai na propia páxina da quedada."

msgid "CommonMessages.POSITIVE_INTEGER_INVALID"
msgstr "Vaia! Isto non parece un número válido. Por favor, envíame un número enteiro positivo. Non se permiten decimais!"

msgid "CommonMessages.TIME_PROMPT"
msgstr "Envíame a hora da quedada co formato <i>HH:MM</i>"

msgid "CommonMessages.TIME_INVALID_VALUE"
msgstr "O meu reloxo interno é antigo e non pode entender esa hora de ciencia ficción 🛸.\n\nInténtao de novo cunha hora que teña horas válidas (00-23) e minutos (00-59), seguro que así entendo 🧠."

msgid "CommonMessages.DATETIME_INPUT_INVALID"
msgstr "Non atopei ningunha data nin hora nesa mensaxe. Escolle un día no calendario, envía a hora co formato <i>HH:MM</i>, ou envía unha mensaxe usando ${datetime_link} para definir a data e a hora dunha vez."

msgid "CommonMessages.DELETED_MEETING_ALERT"
msgstr "Esta quedada eliminouse"

msgid "CommonMessages.UNEXPECTED_ERROR"
msgstr "Vaia! Pasou algo inesperado. Tróuxente de volta ao menú principal. Por favor, inténtao de novo."

msgid "CommonMessages.UNEXPECTED_ERROR_ALERT"
msgstr "Algo saíu mal pola nosa parte. Por favor, inténtao de novo, e escribe a support@mitup.social se segue pasando."

msgid "CommonMessages.ACCOUNT_NOT_FOUND"
msgstr "Non tes conta de Mitup neste momento. Envía /start e prepároche todo."

msgid "CommonMessages.BOT_BLOCKED_ALERT"
msgstr "Bloqueáchesme, así que non podo enviarche mensaxes. Para usar Mitup de novo, desbloquéame e envía /start."

msgid "CommonMessages.CONTEXT_LOST"
msgstr "<b>Vaia, perdemos o fío!</b>\n\nO bot tivo unha actualización interna rápida e esqueceu en que punto do proceso estabas. Todo o que gardaches está a salvo. Por favor, comeza de novo o que estabas a facer desde o menú de abaixo."

msgid "CommonMessages.OLD_VERSION_MESSAGE"
msgstr "Esta mensaxe é dunha versión antiga de Mitup, así que os seus botóns xa non funcionan. A túa conta e as túas quedadas están seguras. Abre o menú principal para continuar."

msgid "CommonMessages.RICH_MESSAGE_NOT_SUPPORTED"
msgstr "<b>Iso é unha mensaxe enriquecida!</b>\n\nVexo que enviaches unha, pero non podo traballar con mensaxes enriquecidas, xa que as páxinas das quedadas manteñen o seu propio formato. Envía o teu texto como unha mensaxe normal e seguiremos. Se escribes algo en <b>negra</b> ou en <i>cursiva</i>, chega perfectamente."

msgid "SupporterMessages.ACTIVE_MEETINGS_CAP"
msgstr "Alcanzaches o teu límite de ${cap} quedadas activas. Pecha ou elimina unha para crear outra, ou faite Host de Mitup en Patreon para desbloquear máis. Tes todos os detalles en Colabora, xusto debaixo."

msgid "SupporterMessages.ACTIVE_MEETINGS_CAP_PATRON"
msgstr "O teu plan Gamemaster admite ata ${cap} quedadas activas, grazas por apoiar Mitup! Pecha ou elimina unha para crear outra, ou pasa a Commissioner en Patreon para eliminar o límite. Tes todos os detalles en Colabora, xusto debaixo."

msgid "SupporterMessages.SCHEDULING_HORIZON"
msgstr "Por agora podes programar quedadas ata ${days} días por adiantado. Escolle unha data máis próxima, ou faite Host de Mitup en Patreon para programar máis lonxe. Tes todos os detalles en Colabora, xusto debaixo."

msgid "SupporterMessages.SCHEDULING_HORIZON_PATRON"
msgstr "O teu plan Gamemaster programa ata ${days} días por adiantado, grazas por apoiar Mitup! Escolle unha data máis próxima, ou pasa a Commissioner en Patreon para programar tan lonxe como queiras. Tes todos os detalles en Colabora, xusto debaixo."

msgid "SupporterMessages.SCHEDULING_HORIZON_TITLE"
msgstr "Esa data está a máis de ${days} días, o máis lonxe que podes programar por agora. Envía o título da túa quedada de novo cunha data máis próxima, ou faite Host de Mitup en Patreon para programar máis lonxe. Tes todos os detalles en Colabora, xusto debaixo."

msgid "SupporterMessages.SCHEDULING_HORIZON_TITLE_PATRON"
msgstr "Esa data está a máis de ${days} días, o máis lonxe que podes programar co teu plan Gamemaster. Envía o título da túa quedada de novo cunha data máis próxima, ou pasa a Commissioner en Patreon para programar tan lonxe como queiras. Tes todos os detalles en Colabora, xusto debaixo."

msgid "SupporterMessages.PARTICIPANT_CAPACITY_EXCEEDED"
msgstr "As quedadas gratuítas admiten ata ${cap} participantes. Envía un número menor, ou faite Host de Mitup en Patreon para organizar quedadas máis grandes: ${button_collaborate}"

msgid "RegistrationMessages.TIMEZONE_PROMPT"
msgstr "Dámosche a benvida a Mitup Bot, ${first_name}!\n\nImos comezar configurando a túa zona horaria. Envíame o nome da túa cidade ou, para un resultado máis preciso, a túa localización tocando en 📎 e seleccionando Localización.\n\n<b>Importante</b>: non almacenamos a túa localización e esta información só se utiliza para configurar a túa zona horaria."

msgid "RegistrationMessages.REGISTRATION_COMPLETE"
msgstr "<b>Todo listo, dámosche a benvida a Mitup!</b> A túa zona horaria é ${timezone} e o bot está preparado para ti.\n\nTodo o que necesitas para crear quedadas e unirte a outras está no menú de abaixo, e a ${user_guide} explica como funciona todo.\n\nSe Mitup che axuda a xuntar a xente, podes apoialo cando queiras desde Colabora."

msgid "RegistrationMessages.USER_GUIDE_LABEL"
msgstr "guía de usuario"

msgid "RegistrationMessages.TIMEZONE_FAIL"
msgstr "Desculpa, non puiden establecer a túa zona horaria. Por favor, inténtao de novo."

msgid "RegistrationMessages.TIMEZONE_INVALID_INPUT"
msgstr "Por favor, envíame o nome da túa cidade como texto ou comparte a túa localización."

msgid "SettingsMessages.TIMEZONE_PROMPT"
msgstr "A túa zona horaria está establecida en <b>${timezone}</b>.\nEnvíame o nome da túa cidade ou a túa localización para establecer a túa zona horaria ou toca en <b>Cancelar</b> para volver."

msgid "SettingsMessages.TIMEZONE_SUCCESS"
msgstr "A túa zona horaria estableceuse en: <b>${timezone}</b>"

msgid "SettingsMessages.TIMEZONE_ON_EXIT"
msgstr "<i>Estabas a cambiar a túa zona horaria.</i>\nEnvía o nome da túa cidade ou a túa localización para continuar, ou toca ${button_cancel} para saír."

msgid "SettingsMessages.LANGUAGE_SUCCESS"
msgstr "O idioma estableceuse correctamente."

msgid "SettingsMessages.DEFAULT_OPTIONS_LEAD"
msgstr "Cada quedada que crees comeza con estes axustes."

msgid "SettingsMessages.TOGGLE_HINT"
msgstr "Toca o estado dun axuste para activalo ou desactivalo."

msgid "SettingsMessages.TIMEOUT_PROMPT"
msgstr "Envía a nova prórroga en minutos, ata <b>${max_timeout}</b> (un día), ou toca Cancelar para volver."

msgid "SettingsMessages.TIMEOUT_INVALID"
msgstr "Vaia! Isto non parece unha prórroga válida. Envía un número enteiro positivo de minutos, ata <b>${max_timeout}</b> (un día). Non se permiten decimais!"

msgid "SettingsMessages.TIMEOUT_SUCCESS"
msgstr "A prórroga estableceuse en: <b>${duration}</b>"

msgid "SettingsMessages.NOTIFICATIONS_TIME_PROMPT"
msgstr "Envía canto tempo antes de que comece unha quedada (en minutos) che gustaría recibir unha notificación ou toca Cancelar para volver."

msgid "SettingsMessages.NOTIFICATIONS_TIME_SUCCESS"
msgstr "Recibirás unha notificación <b>${duration}</b> antes de que comecen as quedadas ás que te uniches."

msgid "PrivacyMessages.INTRO"
msgstr "Os teus datos son teus."

msgid "PrivacyMessages.POLICY_TITLE"
msgstr "Política de privacidade"

msgid "PrivacyMessages.POLICY"
msgstr "Que garda Mitup sobre ti, por que e durante canto tempo."

msgid "PrivacyMessages.EXPORT_TITLE"
msgstr "Os teus datos"

msgid "PrivacyMessages.EXPORT"
msgstr "Descarga unha copia de todo o que Mitup garda sobre ti, nun ficheiro JSON. As demais persoas das túas quedadas aparecen só co nome que mostran."

msgid "PrivacyMessages.EXPORT_ATTACHED"
msgstr "A túa copia vai anexada a esta mensaxe."

msgid "PrivacyMessages.DELETE_TITLE"
msgstr "Eliminación"

msgid "PrivacyMessages.DELETE"
msgstr "Elimina permanentemente todo o que está ligado á túa conta. As quedadas que creaches desaparecen para todas as persoas que se uniron a elas."

msgid "PrivacyMessages.DELETE_WARNING"
msgstr "<b>Borrar todos os teus datos?</b>\n\nIsto eliminará permanentemente todo o que está ligado á túa conta:\n\n- As quedadas que creaches desaparecerán para todas as persoas que se uniron a elas, non só para ti.\n- Eliminarémoste de todas as quedadas ás que te uniches.\n- Os teus axustes e a túa ligazón con Patreon borraranse.\n\n<b>Non hai volta atrás.</b> Os datos borrados non se poden recuperar."

msgid "PrivacyMessages.DELETE_LAST_CHANCE"
msgstr "<b>Última oportunidade</b>\n\nSe confirmas agora, a túa conta deixa de funcionar inmediatamente e a eliminación non se pode deter.\n\nSeguro que queres borrar permanentemente todos os teus datos?"

msgid "PrivacyMessages.DELETION_MARKED"
msgstr "A túa solicitude de eliminación está confirmada e a túa conta deixou de funcionar.\n\nTodo se eliminará permanentemente nun prazo dun día, e recibirás unha última mensaxe confirmando a eliminación. Para volver usar Mitup despois diso, envía o comando /start."

msgid "PrivacyMessages.PENDING_DELETION_ALERT"
msgstr "A túa conta está pendente de eliminación e xa non funciona. Recibirás unha última mensaxe de confirmación. Para volver usar Mitup despois diso, envía o comando /start."

msgid "PrivacyMessages.DELETION_COMPLETE"
msgstr "<b>Os teus datos están borrados</b>\n\nTodo o que estaba ligado á túa conta desapareceu permanentemente: as quedadas que creaches, a túa praza nas quedadas ás que te uniches e os teus axustes. Os botóns das mensaxes antigas deste chat xa non fan nada.\n\nPara volver usar Mitup, envía o comando /start. Mitup xa non ten memoria de ti e configurarate desde cero."

msgid "MeetingCreationMessages.PROMPT"
msgstr "Imos crear unha quedada. Cal é o título?\n\n<i>Consello: tamén podes usar ${datetime_link} para incluír unha data e hora directamente.</i>"

msgid "MeetingCreationMessages.CREATED"
msgstr "Quedada creada: <b>${title}</b>\n\nPodes completala coas opcións da súa páxina, aquí abaixo. A información que non engadas non se mostrará ao compartir a quedada."

msgid "MeetingCreationMessages.INVALID_TITLE"
msgstr "Non recoñecín o que enviaches como un título válido 🤔.\n\nEnvía unha mensaxe co título da quedada ou fai clic en <b>Cancelar</b>."

msgid "MeetingCreationMessages.INVALID_TITLE_ENTITY"
msgstr "Só entendo un título ou un título con data 🤔.\n\nPor favor, envía só o título da quedada, ou o título cunha data formateada por Telegram. Fai clic en <b>Cancelar</b> para saír."

msgid "MeetingCreationMessages.ON_EXIT"
msgstr "<i>Estabas a crear unha quedada.</i>\nEnvía o título da quedada para continuar, ou toca ${button_cancel} para saír."

msgid "MeetingCardSectionMessages.DESCRIPTION"
msgstr "Descrición"

msgid "MeetingCardSectionMessages.WHEN"
msgstr "Cando"

msgid "MeetingCardSectionMessages.WHERE"
msgstr "Onde"

msgid "MeetingCardSectionMessages.PARTICIPANTS"
msgstr "Participantes"

msgid "MeetingCardSectionMessages.COUNT_OF_MAX"
msgstr "${count} de ${max}"

msgid "MeetingDisplayMessages.CREATED_BY"
msgstr "Creada por: ${owner}"

msgid "MeetingDisplayMessages.DATE_NOT_SET"
msgstr "🚫 Sen hora definida 🚫"

msgid "MeetingDisplayMessages.PARTICIPANT_COUNT_EMPTY"
msgstr "Baleiro"

msgid "MeetingDisplayMessages.MAX_PARTICIPANTS_LABEL"
msgstr "(Máx: ${max_participants})"

msgid "MeetingDisplayMessages.PARTICIPANTS_TRUNCATED"
msgstr "${count} nomes non mostrados"

msgid "MeetingDisplayMessages.INVITED_BY"
msgstr "<i>convite de ${user}</i>"

msgid "MeetingDisplayMessages.NOT_PART_OF_MEETING"
msgstr "<i>Non estás nesta quedada.</i>"

msgid "MeetingDisplayMessages.DESCRIPTION_EMPTY"
msgstr "<i>Esta quedada aínda non ten descrición</i>"

msgid "MeetingDisplayMessages.UNTITLED"
msgstr "<i>Quedada sen título</i>"

msgid "MeetingDisplayMessages.IN_PROGRESS_STATUS"
msgstr "<i>Esta quedada está en curso.</i>"

msgid "MeetingDisplayMessages.FINISHED_STATUS"
msgstr "<i>Esta quedada rematou.</i>"

msgid "MeetingDisplayMessages.DELETED_BANNER"
msgstr "🚫 Esta quedada eliminouse 🚫"

msgid "MeetingDisplayMessages.FINISHED_BANNER"
msgstr "✅ Esta quedada rematou ✅"

msgid "MeetingDisplayMessages.BUILT_WITH"
msgstr "Feito con ${mitup}"

msgid "MeetingJoinMessages.JOIN_SUCCESS"
msgstr "Unícheste á quedada!"

msgid "MeetingJoinMessages.JOIN_ALREADY_JOINED"
msgstr "Xa te uniches a esta quedada"

msgid "MeetingJoinMessages.JOIN_FULL"
msgstr "Desculpa! A quedada está chea"

msgid "MeetingJoinMessages.JOIN_FULL_WAITING_LIST"
msgstr "A quedada está chea. Engadímoste á listaxe de espera."

msgid "MeetingJoinMessages.JOIN_UNREGISTERED"
msgstr "Unícheste á quedada, ${user}! Parece que é a primeira vez que usas Mitup, abre un chat con @mitupbot para recibir notificacións e crear novas quedadas!"

msgid "MeetingJoinMessages.LEAVE_SUCCESS"
msgstr "Saíches da quedada"

msgid "MeetingJoinMessages.LEAVE_NOT_JOINED"
msgstr "Non podes saír dunha quedada á que non te uniches"

msgid "MeetingJoinMessages.LEAVE_UNREGISTERED"
msgstr "Saíches da quedada, ${user}! Parece que é a primeira vez que usas Mitup, abre un chat con @mitupbot para recibir notificacións e crear novas quedadas!"

msgid "MeetingJoinMessages.PROMOTED_FROM_WAITING_LIST"
msgstr "Hai unha praza libre na quedada <b>${meeting_title}</b>. Unícheste desde a listaxe de espera!"

msgid "MeetingJoinMessages.JOIN_LOCKED"
msgstr "Esta quedada xa comezou e a súa lista de asistentes está bloqueada."

msgid "MeetingInviteMessages.ON_EXIT"
msgstr "<i>Estabas a convidar a alguén.</i>\nEnvía o nome da persoa para continuar, ou toca ${button_cancel} para saír."

msgid "MeetingInviteMessages.PROMPT"
msgstr "<b>Engadir á lista de convidados</b>\n\nPor favor, contesta co nome da persoa que queres engadir."

msgid "MeetingInviteMessages.CONFIRMATION"
msgstr "<b>Confirmar convite</b>\n\nSeguro que queres engadir <b>${name}</b> á quedada <b>${meeting_title}</b>?"

msgid "MeetingInviteMessages.OPEN_CHAT"
msgstr "Comezar chat privado\n\nPara engadir participantes, necesitas abrir un chat comigo primeiro."

msgid "MeetingInviteMessages.GO_PRIVATE"
msgstr "Continuar en privado\n\nPor favor, cambia ao noso chat privado para enviarme o nome."

msgid "MeetingInviteMessages.SUCCESS"
msgstr "<b>Lista actualizada</b>\n\nEngadimos a <b>${name}</b> á quedada <b>${meeting_title}</b>."

msgid "MeetingInviteMessages.MEETING_FULL"
msgstr "Sen lugares\n\nA lista de convidados está chea. Non podes engadir a ninguén máis a menos que se libere un lugar."

msgid "MeetingInviteMessages.INVITES_DISABLED"
msgstr "Lista de convidados pechada\n\nXa non se permiten máis convites nesta quedada. O organizador pechou a lista."

msgid "MeetingInviteMessages.MEETING_NOT_FOUND"
msgstr "Quedada non atopada\n\nA quedada á que intentas convidar a alguén non existe."

msgid "MeetingInviteMessages.FLOW_CONTEXT"
msgstr "Estabas a convidar a alguén."

msgid "MeetingInviteMessages.CANCELED"
