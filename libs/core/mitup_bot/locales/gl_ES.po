msgid "BroadcastOperatorMessages.UPLOAD_PROMPT"
msgstr "<b>Nova difusión</b>\n\nSube un ficheiro YAML, ou pega o YAML directamente nunha mensaxe.\n\nDebe ser unha listaxe de entradas, cada unha cun código <code>language</code> e unha <code>message</code> en HTML. O inglés (<code>en</code>) é obrigatorio como idioma de reserva."

msgid "BroadcastOperatorMessages.ERROR_INVALID_YAML"
msgstr "🚫 Non puiden interpretar iso como YAML.\n\n<code>${detail}</code>\n\nCorríxeo e envíao de novo."

msgid "BroadcastOperatorMessages.ERROR_NOT_A_LIST"
msgstr "🚫 O contido debe ser unha listaxe de entradas, cada unha cun idioma e unha mensaxe."

msgid "BroadcastOperatorMessages.ERROR_EMPTY_LIST"
msgstr "🚫 A listaxe está baleira. Engade polo menos unha entrada en inglés."

msgid "BroadcastOperatorMessages.ERROR_ENTRY_SHAPE"
msgstr "🚫 A entrada ${position} non é válida. Cada entrada precisa exactamente dous campos: <code>language</code> e <code>message</code>, ambos de texto."

msgid "BroadcastOperatorMessages.ERROR_DUPLICATE_LANGUAGE"
msgstr "🚫 O idioma <b>${language}</b> aparece máis dunha vez. Deixa unha entrada por idioma."

msgid "BroadcastOperatorMessages.ERROR_MISSING_ENGLISH"
msgstr "🚫 O inglés (<code>${language}</code>) é obrigatorio como idioma de reserva. Engade unha entrada <code>en</code>."

msgid "BroadcastOperatorMessages.ERROR_EMPTY_MESSAGE"
