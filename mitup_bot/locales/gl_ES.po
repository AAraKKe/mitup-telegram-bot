msgid "CollaborateMessages.NOT_LINKED"
msgstr "<b>Apoiar Mitup con Patreon</b>\n\nMitup é gratuíto. Se che axuda a xuntar xente, podes apoiar Mitup en Patreon e desbloquear privilexios especiais como agradecemento.\n\nEnlaza a túa conta de Patreon para comezar."

msgid "CollaborateMessages.LINKED_NOT_PATRON"
msgstr "<b>Conta Patreon enlazada</b>\n\nPerfecto. Aínda non es patrón, polo que os privilexios especiais aínda están desactivados. Podes ser patrón e activaranse automaticamente, sen necesidade de enlazar de novo."

msgid "CollaborateMessages.LINKED_PATRON"
msgstr "<b>Es un apoiante</b>\n\nGrazas por apoiar Mitup. Os teus privilexios especiais están activos. Podes desenlazar a túa conta de Patreon acó sempre que queiras."

msgid "CollaborateMessages.UNAVAILABLE"
msgstr "<b>Colabora</b>\n\nO apoio de Patreon non está dispoñible aínda. Volve pronto."

msgid "CollaborateMessages.UNLINKED"
msgstr "A túa conta de Patreon foi desenlazada."

msgid "CollaborateMessages.LINK_CONFIRMED_NO_PATRON"
msgstr "<b>Conta Patreon enlazada</b>\n\nEstás conectado. Podes ser patrón para desbloquear privilexios especiais. Activaranse automaticamente cando o teu apoio estea activo."

