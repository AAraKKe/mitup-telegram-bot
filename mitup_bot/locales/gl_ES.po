msgid "MeetingMessages.LANGUAGE_SET_SUCCESS"
msgstr "O idioma estableceuse correctamente."

msgid "MeetingMessages.PAST_MEETING_DESCRIPTION"
msgstr "Esta quedada xa non está activa. Reactívala para compartirla de novo, ou elimínaa permanentemente."

msgid "MeetingMessages.REACTIVATE_MEETING_SUCCESS"
msgstr "A quedada foi reactivada. Agora podes editarla e compartirla de novo."

msgid "MeetingMessages.DELETE_MEETING"
msgstr "Seguro que queres eliminar esta quedada?"

msgid "MeetingMessages.DELETE_MEETING_SUCCESS"
msgstr "A quedada foi eliminada correctamente"

msgid "MeetingMessages.DELETE_MEETING_DECLINE"
msgstr "Non se vai eliminar a quedada."

msgid "MeetingMessages.ACCESS_TO_DELETED_MEETING"
msgstr "Esta quedada eliminouse"

msgid "MeetingMessages.EDIT_DATE"
msgstr "Escolle a nova data. Preme <b>🗑️ Eliminar data</b> se queres desactivar a data e hora da quedada."

msgid "MeetingMessages.ADD_DATE"
msgstr "Escolle a data."

msgid "MeetingMessages.NEW_DATE_SET_SUCCESS"
msgstr "A data estableceuse a: <b>${datetime}</b>. Para establecer a hora preme <i>${set_time_button}</i>, ou preme <i>${back_edit_button}</i> para volver a editar a quedada."

msgid "MeetingMessages.DATE_UPDATE_SUCCESS"
msgstr "A data estableceuse a: <b>${datetime}</b>"

msgid "MeetingMessages.EDIT_TIME"
msgstr "Envíame a hora da quedada co formato <i>HH:MM</i>"

msgid "MeetingMessages.EDIT_TIME_SUCCESS"
msgstr "A hora da quedada estableceuse a <b>${datetime}</b>"

msgid "MeetingMessages.WRONG_TIME_FORMAT"
msgstr "Non estou seguro de que entendo esa hora 🤔...\n\n"
"Por favor, envía a hora co formato <i>HH:MM</i>, por exemplo <i>15:30</i> ou <i>09:15</i>"

msgid "MeetingMessages.INVALID_TIME"
msgstr "O meu reloxo interno é antigo e non pode entender esa hora de ciencia ficción 🛸.\n\n"
"Intenta de novo coa hora que teña horas válidas (00-23) e minutos (00-59), seguro que así entendo 🧠."

msgid "MeetingMessages.DELETE_DATE_CONFIRMATION"
msgstr "¿Estás seguro de que queres eliminar a data e hora da quedada?"

msgid "MeetingMessages.DELETE_DATE_DECLINE"
msgstr "A data e hora non se eliminarán"

msgid "MeetingMessages.DATE_TIME_DELETED"
msgstr "A data e hora da quedada foron eliminadas correctamente"

msgid "MeetingMessages.MEETING_HAS_BEEN_DELETED"
msgstr "🚫 Esta quedada eliminouse 🚫"

msgid "MeetingMessages.MEETING_HAS_FINISHED"
msgstr "✅ Esta quedada rematou ✅"

msgid "MeetingMessages.EDIT_SETTINGS_MESSAGE"
msgstr "Podes configurar diferentes aspectos da túa quedada:\n\n"
"<b>Lista de espera</b>: permite aos usuarios unirse á quedada incluso cando está chea. Os usuarios que se unan á quedada cando está chea serán engadidos a unha lista de espera e serán engadidos á lista de participantes en cuanto haxa un lugar dispoñible na orde en que se uniron.\n\n"
"<b>Pública</b>: activa esto para permitir que todos os que reciban a quedada a poidan compartir de novo. Perfecta para chegar a máis persoas.\n\n"
"<b>Con convite</b>: activa esta opción para permitir que os usuarios que se uniron á quedada poidan engadir amigos incluso se non están en Telegram.\n\n"
"<b>Incógnito</b>: unha quedada con incógnito habilitado non mostrará as persoas que se uniron á quedada cando se comparta. Solo se mostrará o número de participantes. Aínda poderás ver os participantes.\n\n"
"<b>Mostrar zona horaria</b>: as quedadas normalmente inclúen a zona horaria á que se refiren a data e hora da quedada. Se non necesitas que esta información se amose na mensaxe da quedada podes deshabilitarla acó. Esto tamén deshabilitará o botón <i>Zona horaria</i> que se mostra cando se comparte a quedada."

msgid "MeetingMessages.NO_MEETINGS_FOUND"
msgstr "<i>Aínda non tes ningunha quedada.\n\n"
"Fai clic en <i>${new_meeting_button}</i> no menú principal para crear unha.</i>"

msgid "MeetingMessages.NOT_SEARCHABLE_FOOTNOTE"
msgstr "🔍 Fai esta quedada buscable neste chat."

msgid "MeetingMessages.SEARCHABLE_FOOTNOTE"
