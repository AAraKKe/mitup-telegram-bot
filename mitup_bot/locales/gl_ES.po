msgid "MeetingMessages.CREATE_MEETING_ON_EXIT"
msgstr "Estabas a crear unha quedada. Envía o título da quedada para continuar. Se non queres continuar, toca Cancelar para saír."

msgid "MeetingMessages.EDIT_MEETING_TITLE_ON_EXIT"
msgstr "Desculpa, estaba esperando o título da túa quedada. Te gustaría envialo? Se non, toca Cancelar para saír."

msgid "MeetingMessages.EDIT_MEETING_DESCRIPTION_ON_EXIT"
msgstr "Desculpa, estaba esperando a descrición da túa quedada. Te gustaría enviarla? Se non, toca Cancelar para saír."

msgid "MeetingMessages.EDIT_MEETING_LOCATION_NAME_ON_EXIT"
msgstr "Desculpa, estaba esperando o nome do lugar. Te gustaría envialo? Se non, toca Cancelar para saír."

msgid "MeetingMessages.EDIT_MEETING_LOCATION_COORDINATES_ON_EXIT"
msgstr "Desculpa, estaba esperando a ubicación da túa quedada. Te gustaría enviarla? Se non, toca Cancelar para saír."

msgid "MeetingMessages.EDIT_MEETING_MAX_PARTICIPANTS_ON_EXIT"
msgstr "Desculpa, estaba esperando o número máximo de participantes. Te gustaría envialo? Se non, toca Cancelar para saír."

msgid "MeetingMessages.EDIT_MEETING_KICK_OUT_ON_EXIT"
msgstr "Desculpa, estaba esperando a túa selección para eliminar un participante. Se non, toca Cancelar para saír."

msgid "MeetingMessages.EDIT_MEETING_TIME_ON_EXIT"
msgstr "Desculpa, estaba esperando a nova hora para a túa quedada. Te gustaría enviarla? Se non, toca Cancelar para saír."

msgid "MeetingMessages.INVITE_USER_ON_EXIT"
msgstr "Desculpa, estaba esperando o nome da persoa que queres convidar. Te gustaría envialo? Se non, toca Cancelar para saír."

msgid "MeetingMessages.INVITE_USER_PROMPT"
msgstr "<b>Engadir á lista de convidados</b>\n\nPor favor contesta co nome da persoa que queres engadir."

msgid "MeetingMessages.INVITE_USER_CONFIRMATION"
msgstr "<b>Confirmar adición</b>\n\nEstás seguro de que queres engadir <b>${name}</b> á quedada <b>${meeting_title}</b>?"

msgid "MeetingMessages.INVITE_USER_OPEN_CHAT"
msgstr "Comezar chat privado\n\nPara engadir participantes, necesitas abrir un chat conmigo primeiro."

msgid "MeetingMessages.INVITE_USER_GO_PRIVATE"
msgstr "Continuar en privado\n\nPor favor cambia ao noso chat privado para enviarme o nome."

msgid "MeetingMessages.INVITE_USER_SUCCESS"
msgstr "<b>Lista actualizada</b>\n\nO usuario <b>${name}</b> foi engadido á quedada <b>${meeting_title}</b>."

msgid "MeetingMessages.INVITE_USER_MEETING_FULL"
msgstr "<b>Sen lugares</b>\n\nA lista de convidados está chea. Non podes engadir a ninguén máis a menos que se libre un lugar."

msgid "MeetingMessages.INVITE_USER_INVITES_DISABLED"
msgstr "<b>Lista de convidados pechada</b>\n\nNon se permiten novas adicions nesta quedada. O organizador pechara a lista."

msgid "MeetingMessages.INVITE_USERS_MEETING_NOT_FOUND"
msgstr "<b>Iso foi inesperado...</b>\n\nDe súpeto perdin pista dos detalles da quedada. Esto non debería pasar.\n\nPor favor intenta enviar o nome de novo."

msgid "MeetingMessages.INVITE_USER_MEETING_NOT_FOUND_ON_CALLBACK"
msgstr "<b>Quedada non atopada</b>\n\nA quedada á que intentas convidar a alguén non existe."

msgid "MeetingMessages.INVITE_USERS_CANCELED"
msgstr "O proceso de invitación foi cancelado."

msgid "MeetingMessages.INVITE_USERS_UNEXPECTED_UPDATES"
msgstr "Algo inesperado aconteceu ao engadir o usuario invitado. Por favor intenta de novo."

