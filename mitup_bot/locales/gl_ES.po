msgid "MeetingMessages.JOINED_MEETING_FULL"
msgstr "Desculpa! A quedada está chea"

msgid "MeetingMessages.JOINED_MEETING_FULL_WAITING_LIST"
msgstr "A quedada está chea. Foste engadido á lista de espera."

msgid "MeetingMessages.JOINED_MEETING_UNREGISTERED"
msgstr "Unícheste á quedada, %{user}! Parece que é a primeira vez que usas Mitup, abre un chat con @mitupbot para recibir notificacións e crear novas quedadas!"

