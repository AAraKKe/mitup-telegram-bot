msgid "CommonMessages.STALE_CANCEL_ALERT"
msgstr "You've already answered this question"

msgid "CommonMessages.POSITIVE_INTEGER_INVALID"
msgstr "Oops! That doesn't look like a valid number. Please enter a positive whole number. No decimals allowed!"

msgid "CommonMessages.TIME_PROMPT"
msgstr "Send me the time of the meeting in the format <i>HH:MM</i>"

msgid "CommonMessages.TIME_INVALID_VALUE"
msgstr "My internal clock is old and cannot understand this science fiction time 🛸.\n\nTry again with a time that has valid hours (00-23) and minutes (00-59), I am sure I can work with that 🧠."

msgid "CommonMessages.TIME_INVALID_FORMAT"
msgstr "Not sure I understand that time 🤔...\n\nPlease, send the time in the format <i>HH:MM</i>, for example <i>15:30</i> or <i>09:15</i>"

msgid "CommonMessages.DATETIME_INVALID"
msgstr "Tap <b>Date</b> or <b>Time</b> to update them, or send a message with a ${datetime_link} to set both at once."

msgid "CommonMessages.DELETED_MEETING_ALERT"
msgstr "This meeting has been deleted"

msgid "CommonMessages.UNEXPECTED_ERROR"
msgstr "Oops! Something unexpected happened. I've brought you back to the main menu. Please try again."

msgid "SupporterMessages.ACTIVE_MEETINGS_CAP"
msgstr "You've reached your limit of ${cap} active meetings. Wrap up or delete one to start another, or tap Collaborate in the main menu to support Mitup and unlock more."

msgid "SupporterMessages.ACTIVE_MEETINGS_CAP_PATRON"
msgstr "You've reached the maximum of ${cap} active meetings. Wrap up or delete one before starting another."

msgid "SupporterMessages.SCHEDULING_HORIZON"
msgstr "You can schedule meetings up to ${days} days ahead for now. Pick an earlier date, or tap Collaborate in the main menu to support Mitup and schedule further out."

msgid "SupporterMessages.SCHEDULING_HORIZON_PATRON"
msgstr "You can schedule meetings up to ${days} days ahead. Pick an earlier date."

msgid "SupporterMessages.PARTICIPANT_CAPACITY"
msgstr "Free meetings can host up to ${cap} participants. Set a lower limit, or tap Collaborate in the main menu to support Mitup and host more."

msgid "RegistrationMessages.TIMEZONE_PROMPT"
msgstr "Welcome to Mitup Bot ${first_name}!\n\nLet's start by setting your timezone. Send me the name of your city or, for a more accurate result, your location by pressing on 📎 and selecting Location.\n\n<b>Important</b>: we do not store your location and this information is only used to configure your timezone."

msgid "RegistrationMessages.TIMEZONE_SUCCESS"
msgstr "Your timezone is ${timezone}"

msgid "RegistrationMessages.TIMEZONE_FAIL"
msgstr "I'm sorry, I couldn't set your timezone. Please, try again."

msgid "RegistrationMessages.TIMEZONE_INVALID_INPUT"
msgstr "Please send your city name as text or share your location."

msgid "SettingsMessages.DESCRIPTION"
msgstr "Configure MitUp."

msgid "SettingsMessages.TIMEZONE_PROMPT"
msgstr "Your timezone is set to <b>${timezone}</b>. \nSend me the name of your city or your location to set your timezone or touch in <b>Cancel</b> to go back."

msgid "SettingsMessages.TIMEZONE_SUCCESS"
msgstr "Your timezone has been set to: <b>${timezone}</b> "

msgid "SettingsMessages.TIMEZONE_ON_EXIT"
msgstr "You were in the middle of changing your timezone. Send me either the name of your city or your location to continue.  If you don't want to continue, tap Cancel to exit."

msgid "SettingsMessages.LANGUAGE_PROMPT"
msgstr "Current language: <b>${language}</b>.\n\nSelect a language."

msgid "SettingsMessages.LANGUAGE_SUCCESS"
msgstr "Language set."

msgid "SettingsMessages.DEFAULT_OPTIONS_DESCRIPTION"
msgstr "Here you can configure the default options used when creating a meeting. Do you usually create public meetings? Set it here. Are you always allowing people to invite other people or to share the meeting in other chats? Do it here. All your meetings will inherit this configuration.\n\nYou can configure different aspects of your meeting:\n\n<b>Waiting list</b>: allow users to join the meeting even when it is full. Users joining when it is full will be added to a waiting list and added to the participants list as soon as a spot is available in the order they joined.\n\n<b>Public</b>: activate this to allow everyone that receives the meeting to share it again. Perfect to reach more people.\n\n<b>Open invitations</b>: activate this option to allow users who have joined the meeting to add friends even if those friends are not in Telegram.\n\n<b>Incognito</b>: a meeting with incognito enabled won't show the people that joined the meeting when shared. Only the number of participants will be shown. You will still be able to see the participants.\n\n<b>Show timezone</b>: meetings usually include the timezone the date and time refers of the meeting to. If you don't need this information displayed on the meeting message you can disable it here. This will also disable the <i>Timezone</i> button shown when the meeting is shared.\n\n<b>Lock on start</b>: when enabled and a meeting has a duration set, participants cannot join or leave once the meeting starts. When disabled, participants can still join or leave freely."

msgid "SettingsMessages.TIMEOUT_PROMPT"
msgstr "Timeout defines how long after a meeting starts it is kept active. Meetings without a set duration are deactivated once this time has passed. After deactivation, you can reactivate a meeting from your <b>Past meetings menu</b>.\n\nThe current timeout is <b>${timeout} minutes</b>\n\nSend the timeout (in minutes) you would like to use or touch Cancel to go back."

msgid "SettingsMessages.TIMEOUT_SUCCESS"
msgstr "Timeout set to: <b>${timeout} minutes</b>"

msgid "SettingsMessages.NOTIFICATIONS_DESCRIPTION"
msgstr "Configure MeetUp notifications.\n\nNotifications: ${notifications_status}\nWhen notifications are enabled, MeetUp will notify you <b>${notifications_time} minutes</b> before a meeting starts."

msgid "SettingsMessages.NOTIFICATIONS_TIME_PROMPT"
msgstr "Send how long before a meeting starts (in minutes) you would like to be notified or touch Cancel to go back."

msgid "SettingsMessages.NOTIFICATIONS_TIME_SUCCESS"
msgstr "Notification time set to <b>${notifications_time} minutes</b>."

msgid "SettingsMessages.ENABLED"
msgstr "Enabled ✅"

msgid "SettingsMessages.DISABLED"
msgstr "Disabled ❌"

msgid "MeetingCreationMessages.PROMPT"
msgstr "Lets create a meeting. What is the title?\n\n<i>Tip: you can also use ${datetime_link} to include a date and time directly.</i>"

msgid "MeetingCreationMessages.SUCCESS"
msgstr "Meeting created: <b>${title}</b>\n\nYou can add more information to the meeting with the options below. The information which has not been added won't be shown when the meeting is shared.\n\nWhen finished click on ✅ Done"

msgid "MeetingCreationMessages.INVALID_TITLE"
msgstr "I did not recognize what you sent as a valid title 🤔.\n\nSend a message with the title of the meeting or click on <b>Cancel</b>."

msgid "MeetingCreationMessages.INVALID_TITLE_ENTITY"
msgstr "I only understand a title or a title with a date 🤔.\n\nPlease send just the meeting title, or the title with a date formatted by Telegram. Click <b>Cancel</b> to exit."

msgid "MeetingCreationMessages.ON_EXIT"
msgstr "You were in the middle of creating a meeting. Send the title of the meeting to continue. If you would not like to continue, tap Cancel to exit."

