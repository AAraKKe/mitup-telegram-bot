msgstr "Choose the language of your meeting. This will change the language used when sharing the meeting.\n\nCurrent language: <b>${language}</b>."

msgid "MeetingEditLanguageMessages.SUCCESS"
msgstr "Language set."

msgid "MeetingEditSettingsMessages.DESCRIPTION"
msgstr "You can configure different aspects of your meeting:\n\n<b>Waiting list</b>: allow users to join the meeting even when it is full. Users joining when it is full will be added to a waiting list and added to the participants list as soon as a spot is available in the order they joined.\n\n<b>Public</b>: activate this to allow everyone that receives the meeting to share it again. Perfect to reach more people.\n\n<b>Open invitations</b>: activate this option to allow users who have joined the meeting to add friends even if those friends are not in Telegram.\n\n<b>Incognito</b>: a meeting with incognito enabled won't show the people that joined the meeting when shared. Only the number of participants will be shown. You will still be able to see the participants.\n\n<b>Show timezone</b>: meetings usually include the timezone the date and time refers of the meeting to. If you don't need this information displayed on the meeting message you can disable it here. This will also disable the <i>Timezone</i> button shown when the meeting is shared."

msgid "MeetingEditDateTimeMessages.DESCRIPTION"
msgstr "Choose what you want to set for your meeting.\n\n<i>Tip: you can also send a message using ${datetime_link} to set the date and time at once.</i>"

msgid "MeetingEditDateTimeMessages.DATE_EDIT_PROMPT"
msgstr "Select the new date. Press <b>🗑️ Delete date</b> if you want to unset the date and time of the meeting."

msgid "MeetingEditDateTimeMessages.DATE_ADD_PROMPT"
msgstr "Select the date."

msgid "MeetingEditDateTimeMessages.DATE_ADDED_TIME_PROMPT"
msgstr "The date has been set to <b>${datetime}</b>. The time defaults to 00:00.\n\nSend the time in <i>HH:MM</i> format to change it, or tap Done to keep 00:00."

msgid "MeetingEditDateTimeMessages.DATE_UPDATED"
msgstr "Date set to: ${datetime}"

msgid "MeetingEditDateTimeMessages.TIME_SUCCESS"
msgstr "Time set to ${datetime}"

msgid "MeetingEditDateTimeMessages.ON_EXIT"
msgstr "Sorry, I was expecting the new time for your meeting. Would you like to send it? If not, tap Cancel to exit."

msgid "MeetingEditDateTimeMessages.END_CLEARED_BY_START"
msgstr "The new start time is after the end time, so the end time has been cleared."

msgid "MeetingEditDateTimeMessages.START_IN_PAST"
msgstr "The start time must be in the future."

msgid "MeetingEditWhenMessages.DESCRIPTION_NO_TIMES"
msgstr "Set when your meeting happens. You can set a start time, an end time, or both. You can also lock the attendees list when the meeting starts, so no one can join or leave once it is underway."

msgid "MeetingEditWhenMessages.DESCRIPTION_START_ONLY"
msgstr "Meeting starts at: <b>${start_datetime}</b>\n\nYou can set an end time or lock the attendees list when the meeting starts, so no one can join or leave once it is underway."

msgid "MeetingEditWhenMessages.DESCRIPTION_BOTH"
msgstr "Meeting starts at: <b>${start_datetime}</b>\nMeeting ends at: <b>${end_datetime}</b>\n\nYou can change the times or lock the attendees list when the meeting starts, so no one can join or leave once it is underway."

msgid "MeetingEditWhenMessages.CLEAR_CONFIRMATION"
msgstr "Are you sure you want to clear the start and end times?"

msgid "MeetingEditWhenMessages.CLEAR_DECLINED"
msgstr "The times won't be cleared."

msgid "MeetingEditWhenMessages.CLEAR_SUCCESS"
msgstr "Times removed."

msgid "MeetingEditDurationMessages.END_PROMPT"
msgstr "Meeting starts at <b>${start_datetime}</b>. Set when it ends.\n\n<i>Tip: you can also send a message using ${datetime_link} to set the date and time at once.</i>"

msgid "MeetingEditDurationMessages.END_EDIT_PROMPT"
msgstr "Meeting starts at <b>${start_datetime}</b>. The meeting currently ends at <b>${end_datetime}</b>.\n\nSet the new end time.\n\n<i>Tip: you can also send a message using ${datetime_link} to set the date and time at once.</i>"

msgid "MeetingEditDurationMessages.END_BEFORE_START"
msgstr "The end time must be after the start time."

msgid "MeetingEditDurationMessages.END_IN_PAST"
msgstr "The end time must be in the future."

msgid "MeetingEditDurationMessages.END_DATE_ADDED_TIME_PROMPT"
msgstr "The end date has been set to <b>${datetime}</b>. The time defaults to 23:59.\n\nSend the time in <i>HH:MM</i> format to change it, or tap Done to keep 23:59."

