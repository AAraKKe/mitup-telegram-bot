msgid "MeetingEditParticipantsMessages.DESCRIPTION"
msgstr "Here you will be able to manage the participants of the meeting: you can set the maximum number of people that can attend the meeting as well as kick out any of the participants that joined the meeting."

msgid "MeetingEditParticipantsMessages.MAX_PROMPT"
msgstr "Send me the maximum number of members allowed in the meeting (must be a number greater than 0) or press in <i>No limit</i> to allow an unlimited number of participants."

msgid "MeetingEditParticipantsMessages.MAX_SUCCESS"
msgstr "Max participants set to: <b>${max_participants}</b>"

msgid "MeetingEditParticipantsMessages.NO_LIMIT_LABEL"
msgstr "No limit"

msgid "MeetingEditParticipantsMessages.MAX_INVALID"
