msgid "MeetingMessages.JOINED_MEETING_SUCCESS"
msgstr "You joined the meeting!"

msgid "MeetingMessages.JOINED_MEETING_ALREADY"
msgstr "You have already joined this meeting"

msgid "MeetingMessages.JOINED_MEETING_NOT_FOUND"
msgstr "The meeting you tried to join does not exist"

msgid "MeetingMessages.JOINED_MEETING_FULL"
msgstr "Sorry! The meeting is full"

msgid "MeetingMessages.JOINED_MEETING_FULL_WAITING_LIST"
msgstr "The meeting is full. You have been added to the waiting list."

msgid "MeetingMessages.JOINED_MEETING_UNREGISTERED"
msgstr "You have joined the meeting, %{user}! It seems you have never used Mitup before, open a chat with @mitupbot to be able to received notifications and create new meetings!\n\nIf you don't open a chat with the bot, you can be removed from the meeting at any time."

msgid "MeetingMessages.LEFT_MEETING_SUCCESS"
msgstr "You have left the meeting"

msgid "MeetingMessages.LEFT_MEETING_ALREADY"
msgstr "You cannot leave a meeting you have not joined"

msgid "MeetingMessages.LEFT_MEETING_NOT_FOUND"
msgstr "The meeting you tried to leave does not exist"

msgid "MeetingMessages.LEFT_MEETING_UNREGISTERED"
msgstr "You haveeee left the meeting, %{user}! It seems you have never used Mitup before, open a chat with @mitupbot to be able to received notifications and create new meetings!\n\nIf you don't open a chat with the bot, you can be added to the meeting at any time."

msgid "MeetingMessages.PROMOTED_FROM_THE_WAITING_LIST"
msgstr "There is an open spot in the meeting *${meeting_title}*. You have now been promoted from the waiting list!"

msgid "MeetingMessages.NOTIFICATION_MEETING_STARTING"
msgstr "The meeting _*${meeting_title}*_ is starting soon!"

msgid "MeetingMessages.EDIT_MEETING_TITLE"
msgstr "This is the current title of your meeting:\n*${title}*\n\n Send me the new one"

msgid "MeetingMessages.EDIT_MEETING_DESCRIPTION"
