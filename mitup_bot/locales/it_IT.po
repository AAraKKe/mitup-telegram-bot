msgid "MeetingEditParticipantsMessages.KICK_OUT_CONFIRMATION"
msgstr "Sei sicuro di voler rimuovere <b>${participant}</b> dall'incontro <b>${meeting_title}</b>?"

msgid "MeetingEditParticipantsMessages.KICK_OUT_NOT_IN_MEETING"
msgstr "Il partecipante che hai cercato di rimuovere non è più nell'incontro."

msgid "MeetingEditParticipantsMessages.KICK_OUT_SUCCESS"
msgstr "Il partecipante <b>${participant}</b> è stato rimosso con successo."

msgid "MeetingEditParticipantsMessages.KICK_OUT_SUCCESS_NO_MORE"
msgstr "Il partecipante <b>${participant}</b> è stato rimosso con successo. Non ci sono più partecipanti da rimuovere."

msgid "MeetingEditLanguageMessages.DESCRIPTION"
msgstr "Scegli la lingua del tuo incontro. Questo cambierà la lingua utilizzata quando viene condiviso l'incontro.\n\nLingua corrente: <b>${language}</b>."

msgid "MeetingEditLanguageMessages.SUCCESS"
msgstr "Lingua impostata."

msgid "MeetingLifecycleMessages.PAST_DESCRIPTION"
msgstr "Questo incontro non è più attivo. Riattivalo per condividerlo di nuovo, oppure eliminalo permanentemente."

msgid "MeetingLifecycleMessages.REACTIVATE_SUCCESS"
msgstr "Incontro riattivato. Puoi ora modificarlo e condividerlo di nuovo."

