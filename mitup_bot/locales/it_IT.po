msgid "NotificationMessages.DELETION_WARNING"
msgstr "L'incontro <b>${meeting_title}</b> sarà eliminato permanentemente in <b>${days_until_deletion} giorni</b>.\n\nPer evitare che ciò accada, puoi riattivare l'incontro selezionando il pulsante <b>${reactivate_meeting_button}</b> di seguito.\n\nRicorda che puoi sempre riattivare qualsiasi incontro passato dal pulsante <b>${past_meetings_button}</b> nel menu principale.\n\nSe non desideri riattivare l'incontro, puoi ignorare questo messaggio."

msgid "NotificationMessages.DELETED"
msgstr "L'incontro <b>${meeting_title}</b> è stato eliminato permanentemente."

msgid "NotificationMessages.STARTING_SOON"
msgstr "L'incontro <b>${meeting_title}</b> sta per iniziare!"

msgid "NotificationMessages.STARTED"
msgstr "L'incontro <b>${meeting_title}</b> è iniziato!"

msgid "MeetingEditDurationMessages.END_PROMPT"
msgstr "L'incontro inizia a <b>${start_datetime}</b>. Imposta quando termina.\n\n<i>Suggerimento: puoi anche inviare un messaggio usando ${datetime_link} per impostare la data e l'ora in una sola volta.</i>"

msgid "MeetingEditDurationMessages.END_EDIT_PROMPT"
msgstr "L'incontro inizia a <b>${start_datetime}</b>. L'incontro attualmente termina a <b>${end_datetime}</b>.\n\nImposta il nuovo orario di fine.\n\n<i>Suggerimento: puoi anche inviare un messaggio usando ${datetime_link} per impostare la data e l'ora in una sola volta.</i>"

msgid "MeetingEditDurationMessages.END_BEFORE_START"
msgstr "L'orario di fine deve essere dopo l'orario di inizio."

msgid "MeetingEditDurationMessages.END_IN_PAST"
msgstr "L'orario di fine deve essere nel futuro."

msgid "ButtonMessages.WHEN"
msgstr "🕒 Quando"

msgid "ButtonMessages.SET_START_TIME"
msgstr "▶️ Imposta ora di inizio"

msgid "ButtonMessages.SET_END_TIME"
msgstr "⏹️ Imposta ora di fine"

msgid "ButtonMessages.CLEAR_TIMES"
msgstr "🗑️ Cancella orari"

msgid "MeetingEditWhenMessages.DESCRIPTION_NO_TIMES"
msgstr "Imposta quando avviene il tuo incontro. Puoi impostare un'ora di inizio, un'ora di fine, o entrambe. Puoi anche bloccare l'elenco dei partecipanti quando inizia l'incontro, in modo che nessuno possa unirsi o andarsene una volta che è in corso."

msgid "MeetingEditWhenMessages.DESCRIPTION_START_ONLY"
msgstr "L'incontro inizia a: <b>${start_datetime}</b>\n\nPuoi impostare un'ora di fine o bloccare l'elenco dei partecipanti quando inizia l'incontro, in modo che nessuno possa unirsi o andarsene una volta che è in corso."

msgid "MeetingEditWhenMessages.DESCRIPTION_BOTH"
msgstr "L'incontro inizia a: <b>${start_datetime}</b>\nL'incontro termina a: <b>${end_datetime}</b>\n\nPuoi modificare gli orari o bloccare l'elenco dei partecipanti quando inizia l'incontro, in modo che nessuno possa unirsi o andarsene una volta che è in corso."

msgid "MeetingEditWhenMessages.CLEAR_SUCCESS"
msgstr "Orari rimossi."

msgid "MeetingEditWhenMessages.CLEAR_CONFIRMATION"
msgstr "Sei sicuro di voler cancellare gli orari di inizio e fine?"

msgid "MeetingEditWhenMessages.CLEAR_DECLINED"
msgstr "Gli orari non verranno cancellati."

msgid "MeetingEditDateTimeMessages.END_CLEARED_BY_START"
msgstr "Il nuovo orario di inizio è dopo l'orario di fine, quindi l'orario di fine è stato cancellato."

msgid "MeetingEditDurationMessages.END_STALE_ALERT"
msgstr "L'orario di inizio è stato cancellato. Impostalo di nuovo prima di scegliere un orario di fine."
