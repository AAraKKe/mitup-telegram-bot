msgid "Messages.DEFAULT_MAIN_MENU_DESCRIPTION"
msgstr "Welcome to Mitup Bot!\n\n"
"Choose one of the following options:"

msgid "Messages.DEFAULT_SETTINGS_DESCRIPTION"
msgstr "Configure MitUp."

msgid "SettingsMessages.SET_TIMEZONE_SETTINGS"
msgstr "Your timezone is set to *${timezone}*. \n"
"Send me the name of your city or your location to set your timezone or touch in *Cancel* to go back."

msgid "SettingsMessages.TIMEZONE_SETTINGS_SET_SUCCESS"
msgstr "Your timezone has been set to: *${timezone}* "

msgid "SettingsMessages.SET_REGISTRATION_TIMEZONE"
msgstr "Welcome to Mitup Bot ${first_name}!\n\n"
"Let's start by setting your timezone. Send me the name of your city or, for a more accurate result, your location by pressing on 📎 and selecting Location.\n\n"
"**Important**: we do not store your location and this information is only used to configure your timezone."

msgid "SettingsMessages.REGISTRATION_TIMEZONE_SET_SUCCESS"
msgstr "Perfect! Your timezone is ${timezone}"

msgid "SettingsMessages.REGISTRATION_TIMEZONE_SET_FAIL"
msgstr "I'm sorry, I couldn't set your timezone. Please, try again."

msgid "SettingsMessages.SELECT_LANGUAGE"
msgstr "Select a language"

msgid "MeetingMessages.CREATE"
msgstr "Creiamo un incontro. Qual è il titolo?"

msgid "MeetingMessages.CREATED_SUCCESS"
msgstr "A meeting has been created with the title: *${title}*\n\n"
"You can add more information to the meeting with the options below. The information which has not been added won't be shown when the meeting is shared.\n\n"
"When finished click on ✅ Done"

msgid "MeetingMessages.CREATED_BY"
msgstr "Created by: ${owner}"

msgid "MeetingMessages.DESCRIPTION_NOT_SET"
msgstr "🚫 Nessuna descrizione definita 🚫"

msgid "MeetingMessages.DATE_NOT_SET"
msgstr "🚫 Nessun orario definito 🚫"

msgid "MeetingMessages.LOCATION_NOT_SET"
msgstr "🚫 Nessun luogo definito 🚫"

msgid "MeetingMessages.EMPTY"
msgstr "Empty"

msgid "MeetingMessages.PARTICIPANT"
msgstr "Participant"

msgid "MeetingMessages.PARTICIPANTS"
msgstr "Partecipanti"

msgid "MeetingMessages.MAX_PARTICIPANTS"
msgstr "(Max: ${max_participants})"

msgid "MeetingMessages.MEETING_WITHOUT_DESCRIPTION"
msgstr "_This meeting has no description yet_"

msgid "MeetingMessages.MEETING_WITHOUT_PARTICIPANTS"
msgstr "_This meeting has no participants yet_"

msgid "MeetingMessages.EDIT_MEETING_TITLE"
msgstr "This is the current title of your meeting:\n"
"*${title}*\n\n"
" Send me the new one"

msgid "MeetingMessages.EDIT_MEETING_DESCRIPTION"
msgstr "This is the current description of your meeting:\n"
"${description}\n\n"
" Send me the new one"

msgid "MeetingMessages.TITLE_SET_SUCCESS"
msgstr "The title has been properly set to: *${title}*"

msgid "MeetingMessages.DESCRIPTION_SET_SUCCESS"
msgstr "The description has been properly set to: *${description}*"

msgid "MeetingMessages.EDIT_MEETING_LOCATION"
msgstr "Un incontro può avere un luogo associato. Puoi semplicemente impostare il nome del posto o puoi anche allegarlo. Scegli una qualsiasi delle due opzioni."

msgid "MeetingMessages.EDIT_MEETING_LOCATION_NAME"
msgstr "Inviami il nome del luogo."

msgid "MeetingMessages.EDIT_MEETING_LOCATION_COORDINATES"
msgstr "_Only from the phone 📱_\n\n"
"Send the location of the meeting. Touch on the 📎 icon and then choose location. You can send whatever location you want, not just your current location."

msgid "MeetingMessages.LOCATION_NAME_SET_SUCCESS"
msgstr "The name of the location has been set to: *${name}*"

msgid "MeetingMessages.LOCATION_COORDINATES_SUCCESS"
msgstr "The location has been saved successfuly"

msgid "MeetingMessages.LOCATION_COORDINATES_WRONG"
msgstr "Send me the location again. Remember to touch on the clip icon and choose location."

msgid "MeetingMessages.EDIT_MEETING_PARTICIPANTS"
msgstr "Qui potrai gestire i partecipanti dell'incontro: puoi impostare il numero massimo di persone che possono partecipare all'incontro nonché cacciare qualsiasi partecipante dell'incontro."

msgid "MeetingMessages.EDIT_MEETING_MAX_PARTICIPANTS"
msgstr "Send me the maximum number of members allowed in the meeting \\(must be a number greater than 0\\) or press in _No limit_ to allow an unlimited number of participants."

msgid "MeetingMessages.MAX_PARTICIPANTS_SET_SUCCESS"
msgstr "The maximum number of participants has been set to: *${max_participants}*"

msgid "MeetingMessages.NO_LIMIT_PARTICIPANTS"
msgstr "Senza limiti"

msgid "MeetingMessages.MAX_PARTICIPANTS_SET_FAIL"
msgstr "The maximum number of participants must be a number greater than 0. Please, try again"

msgid "MeetingMessages.EDIT_MEETING_KICK_OUT_PARTICIPANTS"
msgstr "Questi sono gli utenti che si sono uniti all'incontro. Scegli chi vuoi cacciare."

msgid "MeetingMessages.DELETE_MEETING"
msgstr "Sei sicuro di voler eliminare questo incontro?"

msgid "MeetingMessages.DELETE_MEETING_SUCCESS"
msgstr "The meeting has been deleted successfully"

msgid "MeetingMessages.DELETE_MEETING_DECLINE"
msgstr "L'incontro non sarà eliminato"

msgid "MeetingMessages.ACCESS_TO_DELETED_MEETING"
msgstr "Questo incontro è stato eliminato"

msgid "MeetingMessages.EDIT_DATE"
msgstr "Select the new date. Press **🗑️ Delete date** if you want to unset the date and time of the meeting."

msgid "MeetingMessages.ADD_DATE"
msgstr "Select the date."

msgid "MeetingMessages.NEW_DATE_SET_SUCCESS"
msgstr "The date has been set to: **${datetime}**. To set the time press _${set_time_button}_, othwerise press _${back_edit_button}_ to go back to editing the meeting."

msgid "MeetingMessages.DATE_UPDATE_SUCCESS"
msgstr "The date has been set to: **${datetime}**"

msgid "MeetingMessages.EDIT_TIME"
msgstr "Send me the time of the meeting in the format _HH:MM_"

msgid "MeetingMessages.EDIT_TIME_SUCCESS"
msgstr "The time of the meeting has been set to **${datetime}**"

msgid "MeetingMessages.WRONG_TIME_FORMAT"
msgstr "Not sure I understand that time 🤔...\n\n"
"Please, send the time in the format _HH:MM_, for example _15:30_ or _09:15_"

msgid "MeetingMessages.INVALID_TIME"
msgstr "My internal clock is old and cannot understand this science fiction time 🛸.\n\n"
"Try again with a time that has valid hours \\(00-23\\) and minutes \\(00-59\\), I am sure I can work with that 🧠."

msgid "MeetingMessages.DATE_TIME_DELETED"
msgstr "The date and time of the meeting have been deleted successfully"

msgid "MeetingMessages.MEETING_HAS_BEEN_DELETED"
msgstr "🚫 Questo incontro è stato eliminato 🚫"

msgid "MeetingMessages.NO_MEETINGS_FOUND"
msgstr "_You don't have any meetings yet.\n\n"
"Click on _${new_meeting_button}_ in the main menu to create one._"

msgid "MeetingMessages.ACTIVE"
msgstr "Questi sono tutti i tuoi incontri attivi."

