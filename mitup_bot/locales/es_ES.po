msgid "MeetingMessages.DURATION_NO_START_DATETIME"
msgstr "Para establecer una duración, primero establece cuándo comienza la quedada. Elige una fecha y hora abajo.\n\n<i>Consejo: también puedes usar ${datetime_link} para incluir una fecha y hora directamente.</i>"

msgid "MeetingMessages.DURATION_START_DATETIME_SET"
msgstr "Hora de inicio establecida. Ahora establece cuándo termina la quedada."

msgid "MeetingMessages.SET_END_DATETIME_PROMPT"
msgstr "La quedada comienza a <b>${start_datetime}</b>. Establece cuándo termina.\n\n<i>Consejo: también puedes usar ${datetime_link} para incluir una fecha y hora directamente.</i>"

msgid "MeetingMessages.EDIT_END_DATETIME_PROMPT"
msgstr "La quedada comienza a <b>${start_datetime}</b>. Actualmente termina a <b>${end_datetime}</b>.\n\nEstablece la nueva hora de finalización.\n\n<i>Consejo: también puedes usar ${datetime_link} para incluir una fecha y hora directamente.</i>"

msgid "MeetingMessages.END_DATETIME_BEFORE_START"
msgstr "La hora de finalización debe ser posterior a la hora de inicio."

msgid "MeetingMessages.END_DATETIME_IN_PAST"
msgstr "La hora de finalización debe ser en el futuro."
