msgid "MeetingMessages.EDIT_MEETING_LOCATION"
msgstr "Una quedada puede tener una ubicación asociada. Puedes indicar solo su nombre o también añadir la locación. Escoge cualquiera de las dos opciones."

msgid "MeetingMessages.EDIT_MEETING_LOCATION_NAME"
