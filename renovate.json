{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled"
  ],
  "reviewers": [
    "@jparaque"
  ],
  "dependencyDashboardAutoclose": true,
  "dependencyDashboardLabels": [
    "type::dependency-upgrade"
  ],
  "commitMessagePrefix": "🚀 Update:",
  "labels": [
    "type::dependency-upgrade"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "addLabels": [
        "scope::containers"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "additionalBranchPrefix": "docker-",
      "groupName": "Docker images"
    },
    {
      "matchFileNames": [
        "pyproject.toml"
      ],
      "addLabels": [
        "scope::environment"
      ],
      "additionalBranchPrefix": "python-",
      "groupName": "Python dependencies"
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "matchFileNames": [
        ".gitlab-ci.yml"
      ],
      "enabled": false
    }
  ],
  "major": {
    "additionalBranchPrefix": "major-"
  }
}
