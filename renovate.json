{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled",
    ":disableDependencyDashboard"
  ],
  "reviewers": [
    "@jparaque"
  ],
  "commitMessagePrefix": "⬆️ [renovate] ",
  "labels": [
    "type::dependency-upgrade"
  ],
  "configMigration": true,
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "addLabels": [
        "scope::containers"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "additionalBranchPrefix": "docker-",
      "groupName": "Docker images",
      "matchPackageNames": [
        "!/^postgres$/"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "postgres"
      ],
      "addLabels": [
        "scope::containers"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "additionalBranchPrefix": "docker-postgres-",
      "groupName": "Postgres image"
    },
    {
      "description": "Disable Docker updates for Python images as they are handled by a custom manager",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "python",
        "public.ecr.aws/lambda/python"
      ],
      "enabled": false
    },
    {
      "description": "Group all Python dependency bumps across every uv workspace member (root + tools/mb + future libs/apps)",
      "matchFileNames": [
        "**/pyproject.toml"
      ],
      "addLabels": [
        "scope::environment"
      ],
      "additionalBranchPrefix": "python-",
      "groupName": "Python dependencies"
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "matchFileNames": [
        ".gitlab-ci.yml"
      ],
      "enabled": false
    },
    {
      "description": "Silence ruff's noisy patch stream. NOTE: do not add ty here — ty is pre-1.0 (0.0.x), so Renovate classifies every ty release as a patch bump; disabling patch would suppress all ty updates.",
      "matchPackageNames": [
        "ruff"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "enabled": false
    },
    {
      "matchFileNames": [
        ".pre-commit-config.yaml"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "enabled": false
    },
    {
      "matchFileNames": [
        ".pre-commit-config.yaml"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "autoApprove": true,
      "reviewers": [],
      "automerge": true,
      "schedule": [
        "every weekend"
      ]
    },
    {
      "description": "Group Python version updates",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "python"
      ],
      "groupName": "Python version",
      "additionalBranchPrefix": "python-version-",
      "labels": [
        "type::python-upgrade",
        "scope::environment"
      ],
      "commitMessageTopic": "python",
      "ignoreUnstable": true,
      "major": {
        "enabled": false
      }
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Python version across the codebase",
      "managerFilePatterns": [
        "/(^|/)pyproject\\.toml$/",
        "/(^|/)Dockerfile(\\..+)?$/",
        "/^\\.gitlab/ci/test\\.yml$/"
      ],
      "matchStrings": [
        "requires-python = \">=(?<currentValue>[0-9]+\\.[0-9]+)\"",
        "Programming Language :: Python :: (?<currentValue>[0-9]+\\.[0-9]+)",
        "FROM python:(?<currentValue>[0-9]+\\.[0-9]+(?:\\.[0-9]+)?)-slim-bookworm",
        "FROM public\\.ecr\\.aws/lambda/python:(?<currentValue>[0-9]+\\.[0-9]+)",
        "image: python:(?<currentValue>[0-9]+\\.[0-9]+)-bookworm"
      ],
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version",
      "versioningTemplate": "python"
    }
  ],
  "major": {
    "additionalBranchPrefix": "major-"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "every weekend"
    ]
  },
  "pre-commit": {
    "enabled": true
  }
}
