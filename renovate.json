{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled",
    ":disableDependencyDashboard"
  ],
  "reviewers": [
    "@jparaque"
  ],
  "commitMessagePrefix": "⬆️ ",
  "labels": [
    "type::dependency-upgrade"
  ],
  "configMigration": true,
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "addLabels": [
        "scope::containers"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "additionalBranchPrefix": "docker-",
      "groupName": "Docker images",
      "matchPackageNames": [
        "!/^postgres$/"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "postgres"
      ],
      "addLabels": [
        "scope::containers"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "additionalBranchPrefix": "docker-postgres-",
      "groupName": "Postgres image"
    },
    {
      "description": "Disable Docker updates for Python images as they are handled by a custom manager",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "python",
        "public.ecr.aws/lambda/python"
      ],
      "enabled": false
    },
    {
      "matchFileNames": [
        "pyproject.toml"
      ],
      "addLabels": [
        "scope::environment"
      ],
      "additionalBranchPrefix": "python-",
      "groupName": "Python dependencies"
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "matchFileNames": [
        ".gitlab-ci.yml"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "ruff",
        "pyright"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "enabled": false
    },
    {
      "matchFileNames": [
        ".pre-commit-config.yaml"
      ],
      "autoApprove": true,
      "reviewers": [],
      "automerge": true
    },
    {
      "description": "Group Python version updates",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "python"
      ],
      "groupName": "Python version",
      "additionalBranchPrefix": "python-version-",
      "matchUpdateTypes": [
        "minor"
      ],
      "labels": [
        "type::python-upgrade",
        "scope::environment"
      ],
      "commitMessageTopic": "python"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Python version across the codebase",
      "managerFilePatterns": [
        "/^pyproject\\.toml$/",
        "/(^|/)Dockerfile(\\.ci|\\.dev|\\.migrations)?$/",
        "/^dev/docker/Dockerfile$/",
        "/^\\.gitlab/ci/test\\.yml$/"
      ],
      "matchStrings": [
        "requires-python = \">=(?<currentValue>[0-9]+\\.[0-9]+)\"",
        "Programming Language :: Python :: (?<currentValue>[0-9]+\\.[0-9]+)",
        "FROM python:(?<currentValue>[0-9]+\\.[0-9]+)-slim-bookworm",
        "FROM public\\.ecr\\.aws/lambda/python:(?<currentValue>[0-9]+\\.[0-9]+)",
        "image: python:(?<currentValue>[0-9]+\\.[0-9]+)-bookworm"
      ],
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version",
      "versioningTemplate": "python"
    }
  ],
  "major": {
    "additionalBranchPrefix": "major-"
  },
  "pre-commit": {
    "enabled": true
  }
}
