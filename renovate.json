{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled",
    ":disableDependencyDashboard"
  ],
  "reviewers": [
    "@jparaque"
  ],
  "commitMessagePrefix": "⬆️ ",
  "labels": [
    "type::dependency-upgrade"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "excludePackageNames": [
        "postgres"
      ],
      "addLabels": [
        "scope::containers"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "additionalBranchPrefix": "docker-",
      "groupName": "Docker images"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "postgres"
      ],
      "addLabels": [
        "scope::containers"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "additionalBranchPrefix": "docker-postgres-",
      "groupName": "Postgres image"
    },
    {
      "matchFileNames": [
        "pyproject.toml"
      ],
      "addLabels": [
        "scope::environment"
      ],
      "additionalBranchPrefix": "python-",
      "groupName": "Python dependencies"
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "matchFileNames": [
        ".gitlab-ci.yml"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "ruff",
        "pyright"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "enabled": false
    },
    {
      "matchFileNames": [
        ".pre-commit-config.yaml"
      ],
      "autoApprove": true,
      "reviewers": [],
      "automerge": true
    }
  ],
  "major": {
    "additionalBranchPrefix": "major-"
  },
  "pre-commit": {
    "enabled": true
  }
}
