# This Dockerfile builds an image that includes the Python:3.13 image
# with Hatch to allow executing pipeline jobs.
# The image is built by a manual job in any pipeline
FROM python:3.14.0-slim-bookworm

# Combine all installations into a single RUN command to reduce image layers
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg && \
    install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    chmod a+r /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    docker-ce-cli \
    docker-buildx-plugin \
    libpq-dev \
    gcc \
    git \
    libc-dev \
    groff \
    unzip \
    less \
    jq \
    gettext && \
    # Install AWS CLI
    mkdir -p /tmp/aws && \
    curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "/tmp/aws/awscliv2.zip" && \
    unzip /tmp/aws/awscliv2.zip -d /tmp/aws && \
    /tmp/aws/aws/install && \
    rm -rf /tmp/aws && \
    # Install Hatch
    pip install --no-cache-dir hatch && \
    # Clean up apt cache
    rm -rf /var/lib/apt/lists/*

# Configure hatch to use a persistent directory for virtual environments
RUN hatch config set dirs.env.virtual /opt/hatch-venvs

# Use the same project path as the CI job to ensure hatch finds the environment
# The default GitLab CI checkout path is /builds/<group>/<project>
ARG PROJECT_DIR="/builds/meetupbot/mitup-telegram-bot"
RUN mkdir -p ${PROJECT_DIR}
WORKDIR ${PROJECT_DIR}

# Copy pyproject.toml to pre-install dependencies
COPY pyproject.toml .
COPY LICENSE .
# The root pyproject declares tools/mb as a uv workspace member; uv refuses to resolve
# when the member is missing, so its pyproject must exist too. Copying only the
# pyproject (not the sources) keeps this layer's cache keyed on dependency metadata.
COPY tools/mb/pyproject.toml tools/mb/pyproject.toml

# Create minimal package structure to allow dependency installation
RUN mkdir -p mitup_bot && \
    echo '__version__ = "0.0.0"' > mitup_bot/__about__.py && \
    touch mitup_bot/__init__.py && \
    mkdir -p tools/mb/src/mb && \
    touch tools/mb/src/mb/__init__.py tools/mb/src/mb/main.py

# Pre-install dev environment with all dependencies
# This caches all dependencies so CI jobs start faster
RUN hatch env create dev

# Clean up build files, leaving the empty project directory for the CI job to clone into.
RUN rm -rf pyproject.toml LICENSE mitup_bot tools
