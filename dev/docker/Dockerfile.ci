# This Dockerfile builds an image that includes the Python:3.12 image
# with Hatch to allow executing pipeline jobs.
# The image is build by a manual job in any pipeline
FROM python:3.13-slim-bookworm

RUN apt-get update && \
    apt-get install -y libpq-dev gcc groff unzip curl less jq gettext && \
    rm -rf /var/lib/apt/lists/*

# Instal AWS CLI
RUN mkdir aws && cd aws && curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip" && \
    unzip awscliv2.zip && \
    ./aws/install && \
    cd .. && rm -rf aws

# Install Hatch
RUN pip install hatch

# Cache hatch environment
RUN hatch config set dirs.env.virtual .hatch
