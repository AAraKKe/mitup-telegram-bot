# This Dockerfile builds an image that includes the Python:3.13 image
# with Hatch to allow executing pipeline jobs.
# The image is built by a manual job in any pipeline
FROM python:3.13-slim-bookworm

# Install build and runtime dependencies for CI/CD
# First install tools needed to add Docker's official repository
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg && \
    install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    chmod a+r /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    docker-ce-cli \
    docker-buildx-plugin \
    libpq-dev \
    gcc \
    git \
    libc-dev \
    groff \
    unzip \
    less \
    jq \
    gettext && \
    rm -rf /var/lib/apt/lists/*

# Install AWS CLI
RUN mkdir aws && cd aws && curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip" && \
    unzip awscliv2.zip && \
    ./aws/install && \
    cd .. && rm -rf aws

# Install Hatch
RUN pip install --no-cache-dir hatch

# Configure hatch to use local cache directory
RUN hatch config set dirs.env.virtual .hatch

# Set working directory for pre-installing dependencies
WORKDIR /ci-build

# Copy pyproject.toml to pre-install dependencies
COPY pyproject.toml /ci-build/pyproject.toml
COPY LICENSE /ci-build/LICENSE

# Create minimal package structure to allow dependency installation
RUN mkdir -p /ci-build/mitup_bot && \
    echo '__version__ = "0.0.0"' > /ci-build/mitup_bot/__about__.py && \
    touch /ci-build/mitup_bot/__init__.py

# Pre-install dev environment with all dependencies
# This caches all dependencies so CI jobs start faster
RUN hatch env create dev

# Clean up build files - actual code will be checked out in CI jobs
RUN rm -rf /ci-build

# Reset working directory
WORKDIR /builds
