FROM python:3.14.6-slim-bookworm

# Install libraries needed to run psycopg and build packages
# Keep build dependencies in dev image for faster iteration
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libpq-dev \
    gcc \
    libc-dev \
    gettext && \
    rm -rf /var/lib/apt/lists/*

# Set the working directory to /mitup-telegram-bot
WORKDIR /bot

# Install uv
RUN pip install --no-cache-dir uv

# Keep the venv and download cache outside the bind-mounted project directory.
# Both live under /.docker_uv, each on its own named volume: the venv is per-checkout
# (worktrees on different branches can carry different locks) while the download cache
# is the shared mitup-bot-uv-cache volume, so a fresh worktree resolves its venv from
# already-downloaded packages instead of fetching everything again. The two are separate
# mounts, so uv cannot hardlink between them; copy mode makes that explicit instead of
# warning about the fallback on every sync.
ENV UV_PROJECT_ENVIRONMENT=/.docker_uv/venv \
    UV_CACHE_DIR=/.docker_uv/cache \
    UV_LINK_MODE=copy
