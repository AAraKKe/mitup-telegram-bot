# This Dockerfile is used to generate the docker image used to run a lambda
# that runs migrations in RDS.
# It uses the lambda image that contains the python runtime and the lambda
# setup to be able to call the handler when a lambda is launched

# Stage 1: Builder - Build wheel package
FROM public.ecr.aws/lambda/python:3.13 AS builder

# Install build dependencies
RUN dnf install -y libpq-devel gcc && \
  dnf clean all && \
  rm -rf /var/cache/yum

# Install Hatch for building
RUN pip install --no-cache-dir hatch

# Copy source files
COPY mitup_bot /build/mitup_bot
COPY alembic.ini /build/alembic.ini
COPY pyproject.toml /build/pyproject.toml
COPY LICENSE /build/LICENSE

WORKDIR /build

# Build wheel package
RUN hatch build -t wheel

# Stage 2: Runtime - Install only what's needed
FROM public.ecr.aws/lambda/python:3.13 AS runtime

# Install only runtime dependencies
RUN dnf install -y libpq && \
  dnf clean all && \
  rm -rf /var/cache/yum

# Copy wheel and alembic config from builder
COPY --from=builder /build/dist/*.whl /tmp/
COPY --from=builder /build/alembic.ini ${LAMBDA_TASK_ROOT}/alembic.ini

# Install the wheel package
RUN pip install --no-cache-dir /tmp/*.whl && \
  rm -rf /tmp/*.whl

# The CMD needs to be set to the lambda handler
CMD ["mitup_bot.lambdas.migrations.run_migrations"]
